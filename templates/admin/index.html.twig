<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SRS Radio – Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            min-height: 100%;
            font-family: 'Lato', sans-serif;
            background: #0d0d1a;
            color: #fff;
        }

        /* ── Header ── */
        header {
            background: #14142b;
            border-bottom: 1px solid #2a2a4a;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            font-family: 'Raleway', sans-serif;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: .1em;
            color: #b47fff;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .badge {
            display: inline-block;
            background: rgba(180,120,255,.15);
            border: 1px solid rgba(180,120,255,.3);
            border-radius: 20px;
            padding: .15rem .6rem;
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #b47fff;
        }

        nav a {
            color: #6b5a8a;
            text-decoration: none;
            font-size: .85rem;
            margin-left: 1.5rem;
            transition: color .2s;
        }
        nav a:hover { color: #b47fff; }
        nav a.danger { color: #6b3a4a; }
        nav a.danger:hover { color: #f87171; }

        /* ── Main layout ── */
        main {
            padding: 2.5rem 2rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        h2 {
            font-family: 'Raleway', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: .05em;
            margin-bottom: 1.75rem;
            color: #b47fff;
        }

        /* ── Flash messages ── */
        .flash {
            padding: .75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1.25rem;
            font-size: .875rem;
        }
        .flash.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: #86efac; }
        .flash.error   { background: rgba(239,68,68,.1);  border: 1px solid rgba(239,68,68,.3);  color: #fca5a5; }

        /* ── Radio controls ── */
        .radio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        @media (max-width: 600px) { .radio-grid { grid-template-columns: 1fr; } }

        .card {
            background: #14142b;
            border: 1px solid #2a2a4a;
            border-radius: 12px;
            padding: 1.5rem;
        }

        .card-title {
            font-family: 'Raleway', sans-serif;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #6b5a8a;
            margin-bottom: 1.25rem;
        }

        .volume-display {
            text-align: center;
            margin-bottom: 1.25rem;
        }

        .volume-number {
            font-family: 'Raleway', sans-serif;
            font-size: 3.5rem;
            font-weight: 900;
            line-height: 1;
            color: #b47fff;
        }

        /* ── Now playing ── */
        .now-playing {
            display: flex;
            align-items: center;
            gap: .85rem;
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: .75rem;
            min-height: 64px;
        }

        .np-art {
            width: 48px;
            height: 48px;
            border-radius: 5px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .np-text { flex: 1; min-width: 0; }

        .np-track {
            font-weight: 700;
            font-size: .9rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #fff;
        }

        .np-artist {
            font-size: .78rem;
            color: #6b5a8a;
            margin-top: .15rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .np-status {
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #3a2a5a;
            white-space: nowrap;
        }

        .np-status.playing { color: #86efac; }

        .progress-track {
            height: 5px;
            background: #1a1a35;
            border-radius: 3px;
            overflow: hidden;
            width: 100%;
            margin-bottom: .4rem;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #5b21b6, #b47fff);
            border-radius: 3px;
            width: 0%;
            transition: width 1s linear;
        }

        .progress-times {
            display: flex;
            justify-content: space-between;
            font-size: .75rem;
            color: #4a3a6a;
            font-variant-numeric: tabular-nums;
            letter-spacing: .03em;
        }

        .volume-label { font-size: .7rem; color: #4a3a6a; letter-spacing: .1em; text-transform: uppercase; margin-top: .2rem; }
        .volume-backend { font-size: .65rem; color: #3a2a5a; margin-top: .1rem; }

        .volume-bar-track {
            height: 5px;
            background: #1a1a35;
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 1.25rem;
        }

        .volume-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #5b21b6, #b47fff);
            border-radius: 3px;
            transition: width .3s ease;
        }

        .controls { display: flex; gap: .6rem; }

        .btn {
            flex: 1;
            padding: .75rem .5rem;
            border: none;
            border-radius: 8px;
            font-family: 'Raleway', sans-serif;
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: .05em;
            cursor: pointer;
            transition: background .2s, opacity .2s, transform .1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
        }

        .btn:active { transform: scale(.97); }
        .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }

        .btn-vol-down, .btn-vol-up {
            background: #1e1e3f;
            color: #b47fff;
            border: 1px solid #3a2a5a;
        }
        .btn-vol-down:hover:not(:disabled), .btn-vol-up:hover:not(:disabled) { background: #2a2a50; }

        .btn-pause   { background: #1e3a5f; color: #64b5f6; border: 1px solid #2a5a8a; }
        .btn-pause:hover:not(:disabled)   { background: #2a4a7a; }
        .btn-pause.is-paused { background: #1a3d2a; color: #86efac; border-color: #2e7d52; }

        .btn-next    { background: #5b21b6; color: #fff; border: 1px solid #6d28d9; }
        .btn-next:hover:not(:disabled)    { background: #6d28d9; }

        .btn-restart { background: #1e1e3f; color: #b47fff; border: 1px solid #3a2a5a; }
        .btn-restart:hover:not(:disabled) { background: #2a2a50; }

        .btn-start { background: #1a3d2a; color: #86efac; border: 1px solid #2e7d52; }
        .btn-start:hover:not(:disabled) { background: #2e7d52; }

        .btn-stop { background: #3b1111; color: #fca5a5; border: 1px solid #991b1b; }
        .btn-stop:hover:not(:disabled) { background: #991b1b; }

        /* ── Section wrapper ── */
        .section { margin-bottom: 1.25rem; }

        .section-header {
            display: flex;
            align-items: baseline;
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .section-header h2 { margin-bottom: 0; }

        .section-count {
            font-size: .8rem;
            color: #4a3a6a;
        }

        /* ── Birthday layout ── */
        .birthday-layout {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 1rem;
            align-items: start;
        }

        @media (max-width: 800px) { .birthday-layout { grid-template-columns: 1fr; } }

        /* Colleague cards grid */
        .colleague-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: .75rem;
        }

        .colleague-card {
            background: #14142b;
            border: 1px solid #2a2a4a;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .colleague-card.is-today { border-color: #b47fff; box-shadow: 0 0 12px rgba(180,120,255,.25); }

        .colleague-card img {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
            display: block;
        }

        .colleague-placeholder {
            width: 100%;
            aspect-ratio: 1;
            background: #1a1a35;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #3a2a5a;
        }

        .today-badge {
            position: absolute;
            top: .4rem;
            right: .4rem;
            background: #b47fff;
            color: #0d0d1a;
            font-size: .6rem;
            font-weight: 700;
            padding: .15rem .45rem;
            border-radius: 10px;
            letter-spacing: .05em;
        }

        .colleague-info {
            padding: .6rem .75rem .25rem;
        }

        .colleague-name {
            font-weight: 700;
            font-size: .875rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .colleague-bday {
            font-size: .75rem;
            color: #6b5a8a;
            margin-top: .15rem;
        }

        .colleague-card form { padding: .4rem .75rem .6rem; }

        .btn-remove {
            width: 100%;
            background: transparent;
            border: 1px solid #2a1a2a;
            border-radius: 5px;
            color: #6b3a4a;
            font-size: .75rem;
            padding: .3rem;
            cursor: pointer;
            transition: background .2s, color .2s;
            font-family: 'Lato', sans-serif;
        }
        .btn-remove:hover { background: rgba(239,68,68,.1); color: #f87171; border-color: rgba(239,68,68,.3); }

        .no-colleagues {
            color: #3a2a5a;
            font-size: .875rem;
            padding: 1.5rem 0;
        }

        /* ── Add colleague form ── */
        .add-form {
            background: #14142b;
            border-radius: 12px;
            padding: 1.5rem;
        }

        .add-form-title {
            font-family: 'Raleway', sans-serif;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #6b5a8a;
            margin-bottom: 1.25rem;
        }

        .field { margin-bottom: 1rem; }

        .field label {
            display: block;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6b5a8a;
            margin-bottom: .35rem;
        }

        .field input[type="text"],
        .field input[type="date"] {
            width: 100%;
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 6px;
            padding: .6rem .75rem;
            color: #fff;
            font-size: .9rem;
            font-family: 'Lato', sans-serif;
            outline: none;
            transition: border-color .2s;
        }

        .field input:focus { border-color: #7c3aed; }

        /* Picture source tabs */
        .pic-tabs {
            display: flex;
            gap: .4rem;
            margin-bottom: .6rem;
        }

        .pic-tab {
            flex: 1;
            padding: .4rem .6rem;
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 6px;
            color: #6b5a8a;
            font-family: 'Lato', sans-serif;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .05em;
            cursor: pointer;
            transition: background .2s, color .2s, border-color .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
        }

        .pic-tab:hover:not(:disabled) { background: #14142b; color: #b47fff; }
        .pic-tab.active { background: #1e1e3f; border-color: #5b21b6; color: #b47fff; }
        .pic-tab:disabled { opacity: .35; cursor: not-allowed; }

        .pic-tab-count {
            background: rgba(180,120,255,.2);
            color: #b47fff;
            border-radius: 10px;
            padding: .05rem .4rem;
            font-size: .65rem;
        }

        /* Existing images grid */
        .existing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
            gap: .4rem;
            max-height: 220px;
            overflow-y: auto;
            padding: .25rem;
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
        }

        .existing-thumb {
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: border-color .15s, opacity .15s;
            aspect-ratio: 1;
        }

        .existing-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .existing-thumb:hover { border-color: #5b21b6; }
        .existing-thumb.selected { border-color: #b47fff; }

        .existing-selected-hint {
            font-size: .7rem;
            color: #6b5a8a;
            margin-top: .4rem;
            min-height: 1rem;
        }

        /* Picture upload area */
        .pic-upload {
            border: 2px dashed #2a2a4a;
            border-radius: 8px;
            cursor: pointer;
            transition: border-color .2s;
            overflow: hidden;
        }

        .pic-upload:hover { border-color: #5b21b6; }

        .pic-upload input[type="file"] {
            display: none;
        }

        .pic-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: 1.25rem;
            cursor: pointer;
            min-height: 80px;
        }

        .pic-label.has-preview { padding: 0; }

        .pic-preview {
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
            display: none;
            border-radius: 6px;
        }

        .pic-placeholder-icon { font-size: 1.5rem; color: #3a2a5a; }
        .pic-placeholder-text { font-size: .75rem; color: #4a3a6a; text-align: center; }

        .btn-submit {
            width: 100%;
            margin-top: .5rem;
            padding: .75rem;
            background: #5b21b6;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-family: 'Raleway', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            letter-spacing: .06em;
            cursor: pointer;
            transition: background .2s;
        }
        .btn-submit:hover { background: #6d28d9; }

        /* ── Users table ── */
        .section-card {
            background: #14142b;
            border: 1px solid #2a2a4a;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .section-card h3 {
            font-family: 'Raleway', sans-serif;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            padding: .85rem 1rem;
            border-bottom: 1px solid #2a2a4a;
            color: #6b5a8a;
        }

        table { width: 100%; border-collapse: collapse; font-size: .875rem; }
        th {
            text-align: left;
            padding: .6rem 1rem;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #4a3a6a;
            border-bottom: 1px solid #2a2a4a;
        }
        td { padding: .65rem 1rem; border-bottom: 1px solid #1a1a2e; }
        tr:last-child td { border-bottom: none; }

        code {
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 4px;
            padding: .15rem .4rem;
            font-size: .8rem;
            color: #b47fff;
        }

        .hint { font-size: .8rem; color: #4a3a6a; padding: 1rem; }

        /* ── Users table extras ── */
        .role-pill {
            display: inline-block;
            padding: .15rem .55rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-right: .2rem;
        }
        .role-admin { background: rgba(180,120,255,.2); color: #b47fff; }
        .role-user  { background: rgba(100,181,246,.15); color: #64b5f6; }

        .btn-icon {
            background: transparent;
            border: 1px solid #2a2a4a;
            border-radius: 6px;
            color: #6b5a8a;
            font-family: 'Lato', sans-serif;
            font-size: .78rem;
            padding: .3rem .65rem;
            cursor: pointer;
            transition: background .2s, color .2s, border-color .2s;
            margin-right: .35rem;
        }
        .btn-icon:hover { color: #b47fff; border-color: #5b21b6; }
        .btn-icon.danger:hover { color: #f87171; border-color: #991b1b; background: rgba(239,68,68,.1); }
        .btn-icon:disabled { opacity: .4; cursor: not-allowed; }

        /* ── Log viewer ── */
        .log-section { margin-bottom: 2.5rem; }

        .log-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.75rem;
        }

        .log-header h2 { margin-bottom: 0; }

        .log-controls { display: flex; gap: .5rem; align-items: center; }

        .log-auto-badge {
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #86efac;
            background: rgba(34,197,94,.1);
            border: 1px solid rgba(34,197,94,.25);
            border-radius: 20px;
            padding: .15rem .55rem;
        }

        .btn-log-clear {
            background: transparent;
            border: 1px solid #2a1a2a;
            border-radius: 6px;
            color: #4a3a6a;
            font-family: 'Lato', sans-serif;
            font-size: .75rem;
            padding: .25rem .65rem;
            cursor: pointer;
            transition: color .2s, border-color .2s;
        }
        .btn-log-clear:hover { color: #b47fff; border-color: #5b21b6; }

        .log-box {
            background: #070710;
            border: 1px solid #1a1a35;
            border-radius: 10px;
            overflow: hidden;
        }

        .log-body {
            height: 380px;
            overflow-y: auto;
            padding: .85rem 1rem;
            font-family: 'Courier New', Courier, monospace;
            font-size: .78rem;
            line-height: 1.55;
            scroll-behavior: smooth;
        }

        .log-body::-webkit-scrollbar { width: 6px; }
        .log-body::-webkit-scrollbar-track { background: #070710; }
        .log-body::-webkit-scrollbar-thumb { background: #2a2a4a; border-radius: 3px; }

        .log-line { white-space: pre-wrap; word-break: break-all; color: #8888aa; }
        .log-line.ll-info    { color: #86efac; }
        .log-line.ll-warning { color: #fcd34d; }
        .log-line.ll-error   { color: #fca5a5; }
        .log-line.ll-comment { color: #818cf8; }
        .log-line.ll-section { color: #c084fc; font-weight: bold; }
        .log-line.ll-dj      { color: #38bdf8; }
        .log-line.ll-empty   { height: .4rem; }

        .log-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .4rem 1rem;
            border-top: 1px solid #1a1a35;
            font-size: .68rem;
            color: #3a2a5a;
        }

        /* ── Toast ── */
        .toast {
            position: fixed;
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            background: #14142b;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: .6rem 1.25rem;
            font-size: .85rem;
            color: #b47fff;
            opacity: 0;
            transition: opacity .3s, transform .3s;
            pointer-events: none;
            white-space: nowrap;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast.error { border-color: rgba(239,68,68,.4); color: #fca5a5; }

        /* ── Playlist pool ── */
        .pool-list {
            display: flex;
            flex-direction: column;
            gap: .5rem;
            margin-bottom: 1rem;
        }

        .pool-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #14142b;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            padding: .65rem .85rem;
            transition: border-color .2s;
        }

        .pool-item.inactive { opacity: .45; }

        .pool-item-label {
            flex: 1;
            font-size: .875rem;
            font-weight: 700;
        }

        .pool-item-id {
            font-family: 'Courier New', monospace;
            font-size: .7rem;
            color: #4a3a6a;
        }

        .btn-pool-toggle {
            background: none;
            border: 1px solid #2a2a4a;
            border-radius: 5px;
            color: #6b5a8a;
            font-size: .72rem;
            font-weight: 700;
            padding: .2rem .55rem;
            cursor: pointer;
            transition: background .2s, color .2s;
            white-space: nowrap;
        }
        .btn-pool-toggle.active { border-color: #2e7d52; color: #86efac; background: rgba(34,197,94,.07); }
        .btn-pool-toggle.active:hover { background: rgba(34,197,94,.18); }
        .btn-pool-toggle:not(.active):hover { background: rgba(180,120,255,.1); color: #b47fff; border-color: #5b21b6; }

        .btn-pool-remove {
            background: none;
            border: 1px solid #2a1a2a;
            border-radius: 5px;
            color: #6b3a4a;
            font-size: .72rem;
            padding: .2rem .55rem;
            cursor: pointer;
            transition: background .2s, color .2s;
        }
        .btn-pool-remove:hover { background: rgba(239,68,68,.1); color: #f87171; border-color: rgba(239,68,68,.3); }

        .pool-search-row {
            display: flex;
            gap: .6rem;
            margin-bottom: 1rem;
        }

        .pool-search-input {
            flex: 1;
            background: #0a0a1a;
            border: 1px solid #2a2a4a;
            border-radius: 6px;
            padding: .55rem .75rem;
            color: #fff;
            font-size: .875rem;
            font-family: 'Lato', sans-serif;
            outline: none;
            transition: border-color .2s;
        }
        .pool-search-input:focus { border-color: #7c3aed; }

        .btn-pool-search {
            background: #5b21b6;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-family: 'Raleway', sans-serif;
            font-size: .875rem;
            font-weight: 700;
            padding: .55rem 1.1rem;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }
        .btn-pool-search:hover { background: #6d28d9; }
        .btn-pool-search:disabled { opacity: .5; cursor: not-allowed; }

        .pool-results {
            display: flex;
            flex-direction: column;
            gap: .4rem;
        }

        .pool-result-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #0a0a1a;
            border: 1px solid #1a1a30;
            border-radius: 7px;
            padding: .5rem .75rem;
        }

        .pool-result-img {
            width: 36px;
            height: 36px;
            border-radius: 4px;
            object-fit: cover;
            background: #1a1a35;
            flex-shrink: 0;
        }

        .pool-result-text { flex: 1; min-width: 0; }

        .pool-result-name {
            font-size: .875rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pool-result-owner { font-size: .72rem; color: #4a3a6a; }

        .btn-pool-add {
            background: #1a3d2a;
            border: 1px solid #2e7d52;
            border-radius: 5px;
            color: #86efac;
            font-size: .72rem;
            font-weight: 700;
            padding: .25rem .65rem;
            cursor: pointer;
            transition: background .2s;
            white-space: nowrap;
        }
        .btn-pool-add:hover { background: #2e7d52; }
        .btn-pool-add:disabled { opacity: .4; cursor: not-allowed; }

        .pool-empty { font-size: .82rem; color: #3a2a5a; padding: .5rem 0; }

        /* ── Song requests ── */
        .req-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
        .req-table th {
            text-align: left;
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #4a3a6a;
            padding: .6rem 1rem;
            border-bottom: 1px solid #2a2a4a;
        }
        .req-table td { padding: .6rem 1rem; border-bottom: 1px solid #1a1a35; vertical-align: middle; }
        .req-table tr:last-child td { border-bottom: none; }
        .req-table tr:hover td { background: #0f0f22; }

        .req-art {
            width: 36px; height: 36px; border-radius: 4px;
            object-fit: cover; background: #1a1a35; display: block;
        }

        .req-badge {
            display: inline-block;
            font-size: .6rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            padding: .2rem .45rem;
            border-radius: 4px;
        }
        .req-badge.pending  { background: rgba(245,158,11,.15); color: #fbbf24; border: 1px solid #b45309; }
        .req-badge.approved { background: rgba(91,33,182,.3);   color: #b47fff; border: 1px solid #5b21b6; }
        .req-badge.played   { background: rgba(134,239,172,.1); color: #86efac; border: 1px solid #2e7d52; }
        .req-badge.rejected { background: rgba(239,68,68,.1);   color: #fca5a5; border: 1px solid #991b1b; }

        .req-actions { display: flex; gap: .4rem; }
        .btn-approve {
            background: #1a3d2a; color: #86efac; border: 1px solid #2e7d52;
            border-radius: 6px; font-size: .75rem; font-weight: 700;
            padding: .25rem .65rem; cursor: pointer; transition: background .2s;
        }
        .btn-approve:hover { background: #2e7d52; }
        .btn-reject {
            background: #3b1111; color: #fca5a5; border: 1px solid #991b1b;
            border-radius: 6px; font-size: .75rem; font-weight: 700;
            padding: .25rem .65rem; cursor: pointer; transition: background .2s;
        }
        .btn-reject:hover { background: #991b1b; }
        .req-empty { font-size: .82rem; color: #3a2a5a; text-align: center; padding: 1.25rem; }

        /* ── Listener notes (admin) ── */
        .admin-note-item {
            display: flex;
            gap: .75rem;
            align-items: flex-start;
            padding: .65rem 1rem;
            border-bottom: 1px solid #1a1a35;
        }
        .admin-note-item:last-child { border-bottom: none; }
        .admin-note-item:hover { background: #0f0f22; }
        .admin-note-body { flex: 1; min-width: 0; }
        .admin-note-text { font-size: .875rem; color: #e0e0f0; word-break: break-word; }
        .admin-note-meta { margin-top: .2rem; font-size: .72rem; color: #4a3a6a; }
        .admin-note-badge {
            flex-shrink: 0;
            display: inline-block;
            font-size: .6rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            padding: .2rem .45rem;
            border-radius: 4px;
            margin-top: .1rem;
        }
        .admin-note-badge.queued { background: rgba(91,33,182,.3);  color: #b47fff; border: 1px solid #5b21b6; }
        .admin-note-badge.played { background: rgba(134,239,172,.1); color: #86efac; border: 1px solid #2e7d52; }

        /* ── Side navigation ── */
        .side-nav {
            position: fixed;
            top: 70px;
            left: 1.5rem;
            width: 200px;
            max-height: calc(100vh - 90px);
            overflow-y: auto;
            z-index: 100;
        }
        .side-nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .side-nav li { margin-bottom: .25rem; }
        .side-nav a {
            display: block;
            padding: .5rem .75rem;
            color: #6b5a8a;
            text-decoration: none;
            font-size: .8rem;
            font-weight: 500;
            border-radius: 6px;
            transition: background .2s, color .2s, padding-left .2s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .side-nav a:hover {
            background: rgba(180,120,255,.1);
            color: #b47fff;
            padding-left: 1rem;
        }
        .side-nav a.active {
            background: rgba(180,120,255,.15);
            color: #b47fff;
            border-left: 3px solid #b47fff;
            padding-left: .75rem;
        }

        /* Adjust main content for side nav */
        main {
            margin-left: 240px;
        }

        @media (max-width: 1024px) {
            .side-nav { display: none; }
            main { margin-left: 0; }
        }
    </style>
</head>
<body>
    <header>
        <span class="brand">🛡️ SRS RADIO <span class="badge">Admin</span></span>
        <nav>
            <a href="{{ path('app_radio') }}">Radio</a>
            <a href="{{ path('setup') }}">Setup</a>
            <a href="{{ path('app_admin_logout') }}" class="danger">Sign out</a>
        </nav>
    </header>

    {# ── Side navigation ── #}
    <nav class="side-nav" id="sideNav" aria-label="Section navigation">
        <ul>
            <li><a href="#section-radio-controls" data-section="section-radio-controls">Radio controls</a></li>
            <li><a href="#section-song-requests" data-section="section-song-requests">Song requests</a></li>
            <li><a href="#section-listener-notes" data-section="section-listener-notes">Listener notes</a></li>
            <li><a href="#section-playlist-pool" data-section="section-playlist-pool">Playlist pool</a></li>
            <li><a href="#section-theme-thursday" data-section="section-theme-thursday">Theme Thursday</a></li>
            <li><a href="#section-radio-log" data-section="section-radio-log">Radio log</a></li>
            <li><a href="#section-birthday-calendar" data-section="section-birthday-calendar">Birthday calendar</a></li>
            <li><a href="#section-wk-pool" data-section="section-wk-pool">WK Pool</a></li>
            <li><a href="#section-users" data-section="section-users">Users</a></li>
        </ul>
    </nav>

    <main>

        {# Flash messages from colleague create/delete #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# ── Radio controls ── #}
        <section id="section-radio-controls" class="section-anchor">
            <h2>Radio controls</h2>
            <div class="radio-grid">
            <div class="card">
                <div class="card-title">Volume</div>
                <div class="volume-display">
                    <div class="volume-number" id="vol-number">{{ volume ?? '–' }}</div>
                    <div class="volume-label">volume</div>
                    {% if backend %}<div class="volume-backend">via {{ backend }}</div>{% endif %}
                </div>
                <div class="volume-bar-track">
                    <div class="volume-bar-fill" id="vol-bar"
                         style="width: {{ volume is not null ? volume : 0 }}%"></div>
                </div>
                <div class="controls">
                    <button class="btn btn-vol-down" onclick="changeVolume('down')">▼ Down</button>
                    <button class="btn btn-vol-up"   onclick="changeVolume('up')">▲ Up</button>
                </div>
            </div>

            <div class="card">
                <div class="card-title">Playback</div>

                <div class="now-playing">
                    <img id="np-art" class="np-art" src="" alt="" style="display:none">
                    <div class="np-text">
                        <div class="np-track" id="np-track">—</div>
                        <div class="np-artist" id="np-artist">—</div>
                    </div>
                    <div class="np-status" id="np-status"></div>
                </div>

                <div class="progress-wrap" id="progress-wrap" style="display:none;margin-top:.75rem">
                    <div class="progress-track">
                        <div class="progress-bar" id="progress-bar"></div>
                    </div>
                    <div class="progress-times">
                        <span id="time-elapsed">0:00</span>
                        <span id="time-remaining">-0:00</span>
                    </div>
                </div>

                <div class="controls" style="margin-top:.75rem">
                    <button class="btn btn-start"   id="btn-start"   onclick="startRadio()" style="display:none">▶ Start</button>
                    <button class="btn btn-stop"    id="btn-stop"    onclick="stopRadio()"  style="display:none">■ Stop</button>
                    <button class="btn btn-pause"   id="btn-pause"   onclick="togglePause()">⏸ Pause</button>
                    <button class="btn btn-next"    onclick="skipNext()">⏭ Next</button>
                    <button class="btn btn-restart" onclick="restartRadio()">🔄 Restart</button>
                </div>
            </div>
        </div>

{# ── Song requests ── #}
        <section id="section-song-requests" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <path d="M9 18V5l12-2v13"/>
                            <circle cx="6" cy="18" r="3"/>
                            <circle cx="18" cy="16" r="3"/>
                        </svg>
                        Song requests
                    </h2>
                    <span class="section-count" id="req-pending-count"></span>
                </div>

                <div class="section-card">
                <table class="req-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Track</th>
                            <th>Requested by</th>
                            <th>When</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="req-tbody">
                        <tr><td colspan="6" class="req-empty">Loading…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

{# ── Listener notes ── #}
        <section id="section-listener-notes" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                        </svg>
                        Listener notes
                    </h2>
                    <span class="section-count" id="notes-pending-count"></span>
                </div>

                <div class="section-card">
                    <div id="notes-list" style="padding:.5rem 0">
                        <div class="req-empty" id="notes-empty" style="display:none">No notes yet.</div>
                    </div>
                </div>
            </div>
        </section>

        {# ── Playlist pool ── #}
        <section id="section-playlist-pool" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <path d="M4 11V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-5"/>
                            <polyline points="8 11 12 7 16 11"/>
                            <line x1="8" y1="11" x2="16" y2="11"/>
                        </svg>
                        Playlist pool
                    </h2>
                    <span class="section-count" id="pool-count"></span>
                </div>

                <div class="section-card" style="padding:1.25rem">
                <div id="pool-list" class="pool-list">
                    <p class="pool-empty">Loading…</p>
                </div>

                <div class="card-title" style="margin-top:1.5rem;margin-bottom:.75rem">Add playlist from Spotify</div>
                <div class="pool-search-row">
                    <input type="text" id="pool-search-input" class="pool-search-input"
                           placeholder="Search Spotify playlists…"
                           onkeydown="if(event.key==='Enter') searchPlaylists()">
                    <button class="btn-pool-search" id="pool-search-btn" onclick="searchPlaylists()">Search</button>
                </div>
                <div id="pool-results" class="pool-results"></div>
            </div>
        </div>

        {# ◀◀ Theme Thursday ◀◀ #}
        <section id="section-theme-thursday" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        Theme Thursday
                    </h2>
                    <span class="section-count" id="theme-vote-count">{{ theme_vote.counts|length > 0 ? theme_vote.counts|reduce((a,b) => a+b.votes, 0) : 0 }} vote{{ theme_vote.counts|length > 0 ? theme_vote.counts|reduce((a,b) => a+b.votes, 0) != 1 ? 's' : '' : '' }}</span>
                </div>

                <div class="section-card" style="padding:1.5rem">
                    {% if theme_vote.is_thursday %}
                        <div style="text-align:center;padding:1rem">
                            <div style="font-size:3rem;margin-bottom:.5rem">🎭</div>
                            <div style="font-size:1.3rem;font-weight:700;color:#b47fff">
                                {% if theme_vote.winner %}
                                    This Thursday: <span style="color:#fff">{{ theme_vote.winner }}</span>
                                {% else %}
                                    No theme voted this week
                                {% endif %}
                            </div>
                            <div style="color:#6b5a8a;margin-top:.5rem;font-size:.9rem">
                                The radio will play {{ theme_vote.winner ? theme_vote.winner|lower : 'normal playlists' }} all day!
                            </div>
                        </div>

                    {% elseif theme_vote.is_open %}
                        <div class="card-title" style="margin-bottom:1rem">Voting open (Mon–Wed)</div>

                        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
                            <button class="btn btn-pool-search" id="btn-theme-open" onclick="openThemeVote()" style="background:#1a3d2a;border-color:#2e7d52;color:#86efac">
                                ✅ Open voting for this week
                            </button>
                            <button class="btn btn-pool-search" id="btn-theme-close" onclick="closeThemeVote()" style="background:#3b1111;border-color:#991b1b;color:#fca5a5">
                                🔒 Close voting & announce winner
                            </button>
                        </div>

                        <div style="background:#0a0a1a;border:1px solid #1e1e35;border-radius:8px;padding:1rem">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
                                <strong style="color:#b47fff">Current standings</strong>
                                <span style="font-size:.7rem;color:#4a3a6a">
                                    {% set total = theme_vote.counts|reduce((a,b) => a+b.votes, 0) %}
                                    {{ total }} vote{{ total != 1 ? 's' : '' }} total
                                </span>
                            </div>
                            {% set allThemes = ['80s','90s','00s','Dance','Rock','Dutch','Soul','Disco','House','Techno'] %}
                            {% set voteMap = {} %}
                            {% for c in theme_vote.counts %}
                                {% set voteMap = voteMap|merge({(c.theme): c.votes}) %}
                            {% endfor %}
                            <div id="vote-chart-admin" style="display:flex;flex-direction:column;gap:.5rem">
                                {% set maxVotes = theme_vote.max_votes %}
                                {% for theme in allThemes %}
                                    {% set votes = voteMap[theme] ?? 0 %}
                                    {% set pct = maxVotes > 0 ? (votes / maxVotes * 100) : 0 %}
                                    {% set isLeader = votes == maxVotes and maxVotes > 0 %}
                                    <div class="vote-bar-row" style="display:flex;align-items:center;gap:.75rem;opacity:{{ votes > 0 or isLeader ? 1 : 0.5 }}">
                                        <span class="vote-bar-label" style="width:60px;font-size:.75rem;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap">{{ theme }}</span>
                                        <div class="vote-bar-track" style="flex:1;height:26px;background:#0a0a1a;border:1px solid #2a2a4a;border-radius:13px;overflow:hidden;position:relative">
                                            {% if pct > 0 %}
                                                <div class="vote-bar-fill"
                                                     style="height:100%;width:{{ pct }}%;background:linear-gradient(90deg,#5b21b6,#b47fff);border-radius:13px;transition:width .5s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:.5rem;box-sizing:border-box">
                                                    <span class="vote-count" style="font-size:.7rem;font-weight:700;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.5);white-space:nowrap">{{ votes }}</span>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                    {% else %}
                        <div style="text-align:center;padding:2rem;color:#4a3a6a">
                            <div style="font-size:2.5rem;margin-bottom:.5rem">🗓️</div>
                            <div style="font-weight:700;font-size:1.1rem;margin-bottom:.5rem">Voting closed</div>
                            <div style="font-size:.9rem">
                                Voting opens Monday for next Thursday.
                                {% if theme_vote.winner %}
                                    <div style="margin-top:.75rem;color:#b47fff;font-weight:700">This week's theme: <span style="color:#fff">{{ theme_vote.winner }}</span></div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ◀◀ Radio log ◀◀ #}
        <section id="section-radio-log" class="section-anchor">
            <div class="log-section">
                <div class="log-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <path d="M4 19h16"/>
                            <path d="M4 13h16"/>
                            <path d="M4 7h16"/>
                            <path d="M16 19v-4"/>
                            <path d="M8 13v-4"/>
                            <path d="M12 7v-4"/>
                        </svg>
                        Radio log
                    </h2>
                    <div class="log-controls">
                        <span class="log-auto-badge" id="log-auto-badge">● live</span>
                        <button class="btn-log-clear" onclick="toggleLogScroll()">📌 Pin</button>
                    </div>
                </div>
                <div class="log-box">
                    <div class="log-body" id="log-body"></div>
                    <div class="log-footer">
                        <span id="log-line-count">—</span>
                        <span id="log-updated">—</span>
                    </div>
                </div>
            </div>
        </section>

        {# ◀◀ Birthday calendar ◀◀ #}
        <section id="section-birthday-calendar" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>🎂 Birthday calendar</h2>
                    <span class="section-count">{{ colleagues|length }} colleague{{ colleagues|length != 1 ? 's' : '' }}</span>
                </div>
                {# Add form #}
                <div>
                    <form class="add-form" method="post" action="{{ path('colleagues') }}"
                          enctype="multipart/form-data">
                        <div class="add-form-title">Add colleague</div>
                        <input type="hidden" name="_return_to" value="admin">

                        <div class="field">
                            <label for="c-name">Name</label>
                            <input type="text" id="c-name" name="name"
                                   placeholder="e.g. Jan de Vries" required>
                        </div>

                        <div class="field">
                            <label>Birthday (month / day)</label>
                            <div style="display:flex;gap:.5rem">
                                <select id="c-bday-month" name="birthdate_month" required style="flex:1;background:#1a1a3a;border:1px solid #2a2a4a;border-radius:6px;color:#fff;padding:0.6rem 0.8rem;font-size:0.9rem;font-family:inherit">
                                    <option value="">Month</option>
                                    {% set months = {1:'January',2:'February',3:'March',4:'April',5:'May',6:'June',7:'July',8:'August',9:'September',10:'October',11:'November',12:'December'} %}
                                    {% for m in 1..12 %}
                                        <option value="{{ m }}">{{ months[m] }}</option>
                                    {% endfor %}
                                </select>
                                <select id="c-bday-day" name="birthdate_day" required style="flex:1;background:#1a1a3a;border:1px solid #2a2a4a;border-radius:6px;color:#fff;padding:0.6rem 0.8rem;font-size:0.9rem;font-family:inherit">
                                    <option value="">Day</option>
                                    {% for d in 1..31 %}
                                        <option value="{{ d }}">{{ d }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="field">
                            <label>Photo (optional)</label>

                            {# Source toggle #}
                            <div class="pic-tabs">
                                <button type="button" class="pic-tab active" onclick="switchPicTab('upload')">Upload from device</button>
                                <button type="button" class="pic-tab" onclick="switchPicTab('existing')"
                                        {{ existing_images is empty ? 'disabled' : '' }}>
                                    Choose existing
                                    {% if existing_images is not empty %}
                                        <span class="pic-tab-count">{{ existing_images|length }}</span>
                                    {% endif %}
                                </button>
                            </div>

                            {# Upload panel #}
                            <div id="panel-upload">
                                <div class="pic-upload" onclick="document.getElementById('c-pic').click()">
                                    <input type="file" id="c-pic" name="picture"
                                           accept="image/*" onchange="previewPic(this)">
                                    <label class="pic-label" id="pic-label" for="c-pic">
                                        <img id="pic-preview" class="pic-preview" alt="Preview">
                                        <span class="pic-placeholder-icon">📷</span>
                                        <span class="pic-placeholder-text">Click to choose a photo</span>
                                    </label>
                                </div>
                            </div>

                            {# Existing images panel #}
                            <div id="panel-existing" style="display:none">
                                <input type="hidden" name="existing_picture" id="existing_picture" value="">
                                <div class="existing-grid">
                                    {% for img in existing_images %}
                                        <div class="existing-thumb" onclick="selectExisting(this, '{{ img|e('html_attr') }}')"
                                             title="{{ img }}">
                                            <img src="/images/colleagues/{{ img|e('html_attr') }}" alt="{{ img }}">
                                        </div>
                                    {% endfor %}
                                </div>
                                <p id="existing-selected-name" class="existing-selected-hint"></p>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit">Add to calendar</button>
                    </form>
                </div>

                {# Colleague grid #}
                <div style="margin-top: 2rem;">
                    {% if colleagues is empty %}
                        <p class="no-colleagues">No colleagues yet — add one using the form.</p>
                    {% else %}
                        <div class="colleague-grid">
                            {% for c in colleagues %}
                                {% set isToday = c.birthdate|date('m-d') == 'now'|date('m-d') %}
                                <div class="colleague-card {{ isToday ? 'is-today' : '' }}">
                                    {% if isToday %}<span class="today-badge">🎉 Today!</span>{% endif %}

                                    {% if c.picture %}
                                        <img src="/images/colleagues/{{ c.picture }}" alt="{{ c.name }}">
                                    {% else %}
                                        <div class="colleague-placeholder">👤</div>
                                    {% endif %}

                                    <div class="colleague-info">
                                        <div class="colleague-name">{{ c.name }}</div>
                                        <div class="colleague-bday">{{ c.birthdate|date('d F') }}</div>
                                    </div>

                                    <form method="post" action="{{ path('colleagues') }}/{{ c.id }}"
                                          onsubmit="return confirm('Remove {{ c.name|e('js') }}?')">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <input type="hidden" name="_return_to" value="admin">
                                        <button type="submit" class="btn-remove">Remove</button>
                                    </form>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Soccer / WK Pool ── #}
        <section id="section-wk-pool" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                            <circle cx="12" cy="12" r="10"/>
                            <circle cx="12" cy="12" r="4" stroke-width="1"/>
                            <path d="M4.5 4.5l5 5M14.5 14.5l5 5M19.5 4.5l-5 5M9.5 14.5l-5 5" stroke-width="1" opacity=".5"/>
                        </svg>
                        WK Pool
                    </h2>
                </div>
                <div class="section-card" style="padding:1.5rem">
                    <div class="field">
                        <label for="soccer-start">Start date</label>
                        <input type="date" id="soccer-start" value="{{ soccer_start }}" class="pool-search-input">
                    </div>
                    <div class="field">
                        <label for="soccer-end">End date</label>
                        <input type="date" id="soccer-end" value="{{ soccer_end }}" class="pool-search-input">
                    </div>
                    <button class="btn-submit" onclick="saveSoccerDates()">Save dates</button>
                </div>
            </div>
        </section>

{# ── Users ── #}
        <section id="section-users" class="section-anchor">
            <div class="section">
                <div class="section-header">
                    <h2>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#b47fff" stroke-width="1.5" style="vertical-align:middle;margin-right:.25rem">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Users
                </h2>
                <span class="section-count">{{ users|length }} user{{ users|length != 1 ? 's' : '' }}</span>
            </div>

            <div class="section-card">
                {% if users is empty %}
                    <p class="hint">No users yet.</p>
                {% else %}
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                            <tr id="user-row-{{ user.id }}">
                                <td>{{ user.id }}</td>
                                <td>{{ user.displayName }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        <span class="role-pill {{ role == 'ROLE_ADMIN' ? 'role-admin' : 'role-user' }}">
                                            {{ role|replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endfor %}
                                </td>
                                <td>
                                    <button class="btn-icon" onclick="toggleRole({{ user.id }})" id="btn-role-{{ user.id }}">
                                        Toggle admin
                                    </button>
                                    <button class="btn-icon danger" onclick="deleteUser({{ user.id }})" id="btn-delete-{{ user.id }}">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </section>
    </section>

    </main>

    <div class="toast" id="toast"></div>

    <script>
        /* ── Picture tabs ── */
        function switchPicTab(tab) {
            document.getElementById('panel-upload').style.display   = tab === 'upload'   ? '' : 'none';
            document.getElementById('panel-existing').style.display = tab === 'existing' ? '' : 'none';
            document.querySelectorAll('.pic-tab').forEach((el, i) => {
                el.classList.toggle('active', (i === 0) === (tab === 'upload'));
            });

            if (tab === 'upload') {
                // Clear existing selection when switching back to upload
                document.getElementById('existing_picture').value = '';
                document.querySelectorAll('.existing-thumb').forEach(t => t.classList.remove('selected'));
                document.getElementById('existing-selected-name').textContent = '';
            } else {
                // Clear upload input when switching to existing
                document.getElementById('c-pic').value = '';
                resetUploadPreview();
            }
        }

        function selectExisting(el, filename) {
            document.querySelectorAll('.existing-thumb').forEach(t => t.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('existing_picture').value = filename;
            document.getElementById('existing-selected-name').textContent = filename;
        }

        /* ── Upload preview ── */
        function resetUploadPreview() {
            const preview = document.getElementById('pic-preview');
            const label   = document.getElementById('pic-label');
            preview.style.display = 'none';
            preview.src = '';
            label.querySelector('.pic-placeholder-icon').style.display = '';
            label.querySelector('.pic-placeholder-text').textContent = 'Click to choose a photo';
            label.classList.remove('has-preview');
        }

        function previewPic(input) {
            const preview = document.getElementById('pic-preview');
            const label   = document.getElementById('pic-label');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    label.querySelector('.pic-placeholder-icon').style.display = 'none';
                    label.querySelector('.pic-placeholder-text').textContent = input.files[0].name;
                    label.classList.add('has-preview');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        /* ── Now playing poller ── */
        let progressMs  = 0;
        let durationMs  = 0;
        let progressTimer = null;

        function fmtMs(ms) {
            const totalSec = Math.max(0, Math.floor(ms / 1000));
            const m = Math.floor(totalSec / 60);
            const s = String(totalSec % 60).padStart(2, '0');
            return m + ':' + s;
        }

        function updateProgressUI() {
            const wrap = document.getElementById('progress-wrap');
            if (durationMs <= 0) {
                wrap.style.display = 'none';
                return;
            }
            wrap.style.display = '';
            document.getElementById('progress-bar').style.width =
                (progressMs / durationMs * 100) + '%';
            document.getElementById('time-elapsed').textContent   = fmtMs(progressMs);
            document.getElementById('time-remaining').textContent = '-' + fmtMs(durationMs - progressMs);
        }

        function tickProgress() {
            if (durationMs <= 0) return;
            progressMs = Math.min(progressMs + 1000, durationMs);
            updateProgressUI();
        }

        async function pollNowPlaying() {
            try {
                const res  = await fetch('{{ path('app_radio_nowplaying') }}');
                const data = await res.json();

                document.getElementById('np-track').textContent  = data.track  || '—';
                document.getElementById('np-artist').textContent = data.artist || '—';

                const art    = document.getElementById('np-art');
                const status = document.getElementById('np-status');

                if (data.image) {
                    art.src           = data.image;
                    art.style.display = 'block';
                } else {
                    art.style.display = 'none';
                }

                const playing = data.is_playing || data.status === 'playing';
                status.textContent  = playing ? '▶ Playing' : data.status === 'idle' ? 'Idle' : data.status;
                status.className    = 'np-status' + (playing ? ' playing' : '');

                durationMs = data.duration_ms || 0;
                progressMs = data.progress_ms || 0;
                updateProgressUI();

                clearInterval(progressTimer);
                if (playing && durationMs > 0) progressTimer = setInterval(tickProgress, 1000);
            } catch (_) {}
        }

        function setRadioRunning(running) {
            document.getElementById('btn-start').style.display   = running ? 'none' : '';
            document.getElementById('btn-stop').style.display    = running ? ''     : 'none';
            document.getElementById('btn-pause').style.display   = running ? ''     : 'none';
            document.querySelector('.btn-next').style.display    = running ? ''     : 'none';
            document.querySelector('.btn-restart').style.display = running ? ''     : 'none';
        }

        async function pollState() {
            await pollNowPlaying();
            try {
                const res  = await fetch('{{ path('app_admin_state') }}');
                const data = await res.json();
                setPauseButton(data.paused);
                setRadioRunning(data.running);
            } catch (_) {}
        }

        pollState();
        setInterval(pollState, 5000);

        /* ── Volume / next controls ── */
        let toastTimer;

        function showToast(msg, isError = false) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast show' + (isError ? ' error' : '');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.className = 'toast', 2500);
        }

        function setVolume(vol) {
            document.getElementById('vol-number').textContent = vol;
            document.getElementById('vol-bar').style.width = vol + '%';
        }

        async function changeVolume(direction) {
            const btns = document.querySelectorAll('.btn-vol-up, .btn-vol-down');
            btns.forEach(b => b.disabled = true);
            try {
                const res = await fetch('{{ path('app_admin_volume_up') }}'.replace('/up', '/' + direction), {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                });
                const data = await res.json();
                if (data.volume !== undefined) setVolume(data.volume);
                if (!data.success) showToast(data.message || 'Failed', true);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                btns.forEach(b => b.disabled = false);
            }
        }

        async function skipNext() {
            const btn = document.querySelector('.btn-next');
            btn.disabled = true;
            try {
                const res  = await fetch('{{ path('app_admin_next') }}', { method: 'POST' });
                const data = await res.json();
                showToast(data.message || (data.success ? 'Skipped!' : 'Failed'), !data.success);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                btn.disabled = false;
            }
        }

        function setPauseButton(paused) {
            const btn = document.getElementById('btn-pause');
            btn.textContent = paused ? '▶ Resume' : '⏸ Pause';
            btn.classList.toggle('is-paused', paused);
        }

        async function togglePause() {
            const btn = document.getElementById('btn-pause');
            btn.disabled = true;
            try {
                const res  = await fetch('{{ path('app_admin_pause') }}', { method: 'POST' });
                const data = await res.json();
                if (data.success) setPauseButton(data.paused);
                showToast(data.message || (data.success ? 'Done' : 'Failed'), !data.success);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                btn.disabled = false;
            }
        }

        async function stopRadio() {
            const btn = document.getElementById('btn-stop');
            btn.disabled = true;
            btn.textContent = '■ Stopping…';
            try {
                const res  = await fetch('{{ path('app_admin_stop') }}', { method: 'POST' });
                const data = await res.json();
                showToast(data.message || (data.success ? 'Stopping…' : 'Failed'), !data.success);
                if (data.success) setTimeout(pollState, 3000);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                setTimeout(() => { btn.disabled = false; btn.textContent = '■ Stop'; }, 5000);
            }
        }

        async function startRadio() {
            const btn = document.getElementById('btn-start');
            btn.disabled = true;
            btn.textContent = '▶ Starting…';
            try {
                const res  = await fetch('{{ path('app_admin_start') }}', { method: 'POST' });
                const data = await res.json();
                showToast(data.message || (data.success ? 'Starting…' : 'Failed'), !data.success);
                if (data.success) setTimeout(pollState, 3000);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                setTimeout(() => { btn.disabled = false; btn.textContent = '▶ Start'; }, 5000);
            }
        }

        async function saveSoccerDates() {
            const start = document.getElementById('soccer-start').value;
            const end   = document.getElementById('soccer-end').value;
            try {
                const res = await fetch('{{ path('app_admin_soccer_save') }}', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({start, end}),
                });
                const data = await res.json();
                showToast(data.success ? 'Saved!' : data.error || 'Failed', !data.success);
            } catch (e) {
                showToast('Request failed', true);
            }
        }

        async function restartRadio() {
            const btn = document.querySelector('.btn-restart');
            btn.disabled = true;
            btn.textContent = '🔄 Restarting…';
            try {
                const res  = await fetch('{{ path('app_admin_restart') }}', { method: 'POST' });
                const data = await res.json();
                showToast(data.message || (data.success ? 'Restarting…' : 'Failed'), !data.success);
            } catch (e) {
                showToast('Request failed', true);
            } finally {
                setTimeout(() => { btn.disabled = false; btn.textContent = '🔄 Restart'; }, 8000);
            }
        }

        /* ── Log viewer ── */
        let logPinned = false;

        function classifyLine(text) {
            if (text === '') return 'll-empty';
            const t = text.toLowerCase();
            if (t.includes('[error]') || t.includes('error:') || t.includes('exception')) return 'll-error';
            if (t.includes('[warning]') || t.includes('warning:') || t.startsWith(' ! ')) return 'll-warning';
            if (t.includes('[ok]') || t.includes('[success]') || t.startsWith(' [ok]')) return 'll-info';
            if (t.includes('dj:') || t.includes('[birthday]') || t.includes('[alarm]') || t.includes('[comment]')) return 'll-dj';
            if (t.startsWith(' --- ') || (text.startsWith(' ') && text.trim().startsWith('SRS FM'))) return 'll-section';
            if (t.includes('<info>') || t.includes('→ sonos') || t.includes('→ spotify') || t.includes('verbonden')) return 'll-info';
            if (t.includes('<comment>') || t.includes('pool:') || t.includes('backend:') || t.includes('waiting') || t.startsWith(' > ')) return 'll-comment';
            return '';
        }

        function toggleLogScroll() {
            logPinned = !logPinned;
            const badge = document.getElementById('log-auto-badge');
            const btn   = document.querySelector('.btn-log-clear');
            badge.textContent = logPinned ? '● pinned' : '● live';
            badge.style.color = logPinned ? '#fcd34d' : '#86efac';
            badge.style.background = logPinned ? 'rgba(252,211,77,.1)' : 'rgba(34,197,94,.1)';
            badge.style.borderColor = logPinned ? 'rgba(252,211,77,.25)' : 'rgba(34,197,94,.25)';
            btn.textContent = logPinned ? '▶ Live' : '📌 Pin';
        }

        async function pollLog() {
            try {
                const res  = await fetch('{{ path('app_admin_log') }}');
                const data = await res.json();
                const body = document.getElementById('log-body');

                const fragment = document.createDocumentFragment();
                (data.lines || []).forEach(line => {
                    const div = document.createElement('div');
                    div.className = 'log-line ' + classifyLine(line);
                    div.textContent = line || ' ';
                    fragment.appendChild(div);
                });

                body.innerHTML = '';
                body.appendChild(fragment);

                document.getElementById('log-line-count').textContent = (data.lines || []).length + ' lines';
                document.getElementById('log-updated').textContent = 'updated ' + new Date().toLocaleTimeString('nl-NL');

                if (!logPinned) {
                    body.scrollTop = body.scrollHeight;
                }
            } catch (_) {}
        }

        pollLog();
        setInterval(pollLog, 4000);

        /* ── Inline name editor ── */
        /* ── Song requests ── */
        function reqTimeAgo(ts) {
            const diff = Math.floor(Date.now() / 1000) - ts;
            if (diff < 60)    return 'just now';
            if (diff < 3600)  return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
            return Math.floor(diff / 86400) + 'd ago';
        }

        function escReq(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        async function pollSongRequests() {
            try {
                const res  = await fetch('{{ path('app_admin_song_requests') }}');
                const list = await res.json();
                const tbody = document.getElementById('req-tbody');

                if (!list.length) {
                    tbody.innerHTML = '<tr><td colspan="6" class="req-empty">No requests yet.</td></tr>';
                    document.getElementById('req-pending-count').textContent = '';
                    return;
                }

                const pending = list.filter(r => r.status === 'pending').length;
                document.getElementById('req-pending-count').textContent =
                    pending ? pending + ' pending' : list.length + ' total';

                tbody.innerHTML = list.map(r => {
                    const canAct = r.status === 'pending';
                    return '<tr>' +
                        '<td>' + (r.imageUrl
                            ? '<img class="req-art" src="' + escReq(r.imageUrl) + '" alt="">'
                            : '<div class="req-art"></div>') + '</td>' +
                        '<td><strong>' + escReq(r.title) + '</strong><br><span style="color:#6b5a8a;font-size:.8rem">' + escReq(r.artist) + '</span></td>' +
                        '<td>' + escReq(r.requestedBy) + '</td>' +
                        '<td style="color:#4a6a8a;font-size:.8rem">' + reqTimeAgo(r.requestedAt) + '</td>' +
                        '<td><span class="req-badge ' + r.status + '">' + r.status.charAt(0).toUpperCase() + r.status.slice(1) + '</span></td>' +
                        '<td><div class="req-actions">' +
                            (canAct ? '<button class="btn-approve" onclick="approveRequest(' + r.id + ')">Approve</button>' : '') +
                            (canAct ? '<button class="btn-reject"  onclick="rejectRequest(' + r.id + ')">Reject</button>'   : '') +
                        '</div></td>' +
                    '</tr>';
                }).join('');
            } catch (_) {}
        }

        async function approveRequest(id) {
            try {
                await fetch('{{ path('app_admin_song_request_approve', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'POST' });
                showToast('Request approved — will play at next song boundary!');
                pollSongRequests();
            } catch (_) { showToast('Failed', true); }
        }

        async function rejectRequest(id) {
            try {
                await fetch('{{ path('app_admin_song_request_reject', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'POST' });
                showToast('Request rejected.');
                pollSongRequests();
            } catch (_) { showToast('Failed', true); }
        }

        pollSongRequests();
        setInterval(pollSongRequests, 8000);

        /* ── Listener notes ── */
        async function pollListenerNotes() {
            try {
                const res   = await fetch('{{ path('app_admin_listener_notes') }}');
                const notes = await res.json();
                const list  = document.getElementById('notes-list');
                const empty = document.getElementById('notes-empty');

                list.querySelectorAll('.admin-note-item').forEach(el => el.remove());

                const pending = notes.filter(n => (n.status || 'queued') === 'queued').length;
                document.getElementById('notes-pending-count').textContent =
                    pending ? pending + ' queued' : notes.length + ' total';

                if (!notes.length) {
                    empty.style.display = 'block';
                    return;
                }
                empty.style.display = 'none';

                notes.forEach(note => {
                    const status = note.status || 'queued';
                    const item   = document.createElement('div');
                    item.className = 'admin-note-item';
                    item.innerHTML =
                        '<div class="admin-note-body">' +
                            '<div class="admin-note-text">' + escReq(note.text) + '</div>' +
                            '<div class="admin-note-meta">' + escReq(note.sender) + ' · ' + reqTimeAgo(note.at) + '</div>' +
                        '</div>' +
                        '<span class="admin-note-badge ' + status + '">' + (status === 'played' ? 'Aired' : 'Queued') + '</span>';
                    list.appendChild(item);
                });
            } catch (_) {}
        }

        pollListenerNotes();
        setInterval(pollListenerNotes, 8000);

        /* ── Playlist pool ── */
        let poolSearchResults = [];
        let poolIds = new Set(); // currently added spotifyIds for "already added" state

        async function loadPool() {
            try {
                const res  = await fetch('{{ path('app_admin_playlists') }}');
                const list = await res.json();

                poolIds = new Set(list.map(p => p.spotifyId));

                const container = document.getElementById('pool-list');
                document.getElementById('pool-count').textContent =
                    list.length + ' playlist' + (list.length !== 1 ? 's' : '');

                if (!list.length) {
                    container.innerHTML = '<p class="pool-empty">No playlists yet — add one below.</p>';
                    return;
                }

                container.innerHTML = list.map(p => `
                    <div class="pool-item ${p.active ? '' : 'inactive'}" id="pool-item-${p.id}">
                        <span class="pool-item-label">${escReq(p.label)}</span>
                        <span class="pool-item-id">${escReq(p.spotifyId)}</span>
                        <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;white-space:nowrap">
                            <input type="checkbox" class="pool-item-thu" data-id="${p.id}" ${p.themeThursday ? 'checked' : ''}
                                style="width:16px;height:16px;accent-color:#b47fff">
                            <span style="font-size:.7rem;font-weight:700;color:#b47fff;text-transform:uppercase;letter-spacing:.05em">Theme Thu</span>
                        </label>
                        <input type="text" class="pool-item-thu-title" data-id="${p.id}" value="${escReq(p.themeThursdayTitle || '')}"
                            placeholder="Title (e.g. Hardrock)"
                            style="width:120px;padding:.2rem .5rem;border:1px solid #2a2a4a;border-radius:4px;background:#0a0a1a;color:#fff;font-size:.7rem;font-family:inherit"
                            ${!p.themeThursday ? 'disabled' : ''}>
                        <button class="btn-pool-toggle ${p.active ? 'active' : ''}"
                                data-id="${p.id}">
                            ${p.active ? 'Active' : 'Inactive'}
                        </button>
                        <button class="btn-pool-remove" data-id="${p.id}" data-label="${escReq(p.label)}">Remove</button>
                    </div>
                `).join('');

                container.querySelectorAll('.btn-pool-toggle').forEach(btn => {
                    btn.addEventListener('click', () => togglePlaylist(parseInt(btn.dataset.id)));
                });
                container.querySelectorAll('.btn-pool-remove').forEach(btn => {
                    btn.addEventListener('click', () => removePlaylist(parseInt(btn.dataset.id), btn.dataset.label));
                });
                container.querySelectorAll('.pool-item-thu').forEach(chk => {
                    chk.addEventListener('change', () => updatePlaylistThemeThursday(parseInt(chk.dataset.id), chk.checked));
                });
                container.querySelectorAll('.pool-item-thu-title').forEach(input => {
                    input.addEventListener('blur', () => updatePlaylistThemeThursdayTitle(parseInt(input.dataset.id), input.value));
                });

                // Refresh add-buttons in search results
                renderSearchResults();
            } catch (_) {}
        }

        async function updatePlaylistThemeThursday(id, themeThursday) {
            try {
                const res  = await fetch('{{ path('app_admin_playlist_theme_thursday', {'id': '__ID__'}) }}'.replace('__ID__', id), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ themeThursday }),
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('Theme Thursday updated.');
                    loadPool(); // Reload to enable/disable title input
                } else {
                    showToast(data.error || 'Failed', true);
                    loadPool();
                }
            } catch (_) { showToast('Request failed.', true); loadPool(); }
        }

        async function updatePlaylistThemeThursdayTitle(id, title) {
            try {
                const res  = await fetch('{{ path('app_admin_playlist_theme_thursday', {'id': '__ID__'}) }}'.replace('__ID__', id), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ themeThursdayTitle: title }),
                });
                const data = await res.json();
                if (!res.ok) {
                    showToast(data.error || 'Failed', true);
                    loadPool();
                }
            } catch (_) { showToast('Request failed.', true); loadPool(); }
        }
                }
            } catch (_) { showToast('Request failed.', true); loadPool(); }
        }

        async function togglePlaylist(id) {
            try {
                const res  = await fetch('{{ path('app_admin_playlist_toggle', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'POST' });
                const data = await res.json();
                if (res.ok) {
                    showToast(data.active ? 'Playlist enabled.' : 'Playlist disabled.');
                    loadPool();
                } else {
                    showToast(data.error || 'Failed', true);
                }
            } catch (_) { showToast('Request failed.', true); }
        }

        async function removePlaylist(id, label) {
            if (!confirm('Remove "' + label + '" from the pool?')) return;
            try {
                const res  = await fetch('{{ path('app_admin_playlist_remove', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'DELETE' });
                if (res.ok) {
                    showToast('"' + label + '" removed from pool.');
                    loadPool();
                } else {
                    showToast('Failed to remove.', true);
                }
            } catch (_) { showToast('Request failed.', true); }
        }

        async function addPlaylist(spotifyId, label) {
            try {
                const res  = await fetch('{{ path('app_admin_playlist_add') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ spotifyId, label }),
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('"' + label + '" added to pool.');
                    document.getElementById('pool-search-input').value = '';
                    poolSearchResults = [];
                    document.getElementById('pool-results').innerHTML = '';
                    loadPool();
                } else {
                    showToast(data.error || 'Failed to add.', true);
                }
            } catch (_) { showToast('Request failed.', true); }
        }

        async function searchPlaylists() {
            const input = document.getElementById('pool-search-input');
            const btn   = document.getElementById('pool-search-btn');
            const query = input.value.trim();
            if (!query) return;

            btn.disabled    = true;
            btn.textContent = 'Searching…';

            try {
                const res  = await fetch('{{ path('app_admin_playlist_search') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query }),
                });
                const data = await res.json();
                poolSearchResults = data.results || [];
                renderSearchResults();
                if (data.error) showToast('Search error: ' + data.error, true);
                if (!poolSearchResults.length) document.getElementById('pool-results').innerHTML = '<p class="pool-empty">No results found.</p>';
            } catch (e) {
                showToast('Search failed: ' + e.message, true);
            } finally {
                btn.disabled    = false;
                btn.textContent = 'Search';
            }
        }

        function renderSearchResults() {
            const container = document.getElementById('pool-results');
            if (!poolSearchResults.length) {
                container.innerHTML = poolSearchResults !== null ? '' : '<p class="pool-empty">No results.</p>';
                return;
            }

            container.innerHTML = poolSearchResults.map(r => {
                const alreadyAdded = poolIds.has(r.id);
                return `
                    <div class="pool-result-item">
                        ${r.image
                            ? `<img class="pool-result-img" src="${escReq(r.image)}" alt="">`
                            : `<div class="pool-result-img"></div>`}
                        <div class="pool-result-text">
                            <div class="pool-result-name">${escReq(r.name)}</div>
                            <div class="pool-result-owner">${escReq(r.owner)}</div>
                        </div>
                        <button class="btn-pool-add"
                                data-id="${escReq(r.id)}"
                                data-name="${escReq(r.name)}"
                                ${alreadyAdded ? 'disabled' : ''}>
                            ${alreadyAdded ? '✓ Added' : '+ Add'}
                        </button>
                    </div>
                `;
            }).join('');

            container.querySelectorAll('.btn-pool-add:not([disabled])').forEach(btn => {
                btn.addEventListener('click', () => addPlaylist(btn.dataset.id, btn.dataset.name));
            });
        }

        loadPool();

        /* ── Users ── */
        async function toggleRole(id) {
            const btn = document.getElementById('btn-role-' + id);
            btn.disabled = true;
            try {
                const res = await fetch('{{ path('app_admin_user_toggle_role', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'POST' });
                const data = await res.json();
                if (data.error) { showToast(data.error, true); return; }
                location.reload();
            } catch {
                showToast('Failed to toggle role', true);
            } finally {
                btn.disabled = false;
            }
        }

        async function deleteUser(id) {
            if (!confirm('Delete this user? This cannot be undone.')) return;
            const btn = document.getElementById('btn-delete-' + id);
            btn.disabled = true;
            try {
                const res = await fetch('{{ path('app_admin_user_delete', {'id': '__ID__'}) }}'.replace('__ID__', id), { method: 'POST' });
                const data = await res.json();
                if (data.error) { showToast(data.error, true); btn.disabled = false; return; }
                const row = document.getElementById('user-row-' + id);
                row.style.transition = 'opacity .3s';
                row.style.opacity = '0';
                setTimeout(() => row.remove(), 300);
                showToast('User deleted');
            } catch {
                showToast('Failed to delete user', true);
            } finally {
                btn.disabled = false;
}
    }

        /* ── Theme Thursday ── */
        async function openThemeVote() {
            const btn = document.getElementById('btn-theme-open');
            btn.disabled = true;
            btn.textContent = 'Opening…';

            try {
                const res = await fetch('{{ path('app_admin_theme_vote_open') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ force: true }),
                });
                const data = await res.json();

                if (res.ok) {
                    showToast('Theme Thursday voting opened!');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.error || 'Failed to open voting', true);
                }
            } catch {
                showToast('Could not reach server', true);
            } finally {
                btn.disabled = false;
                btn.textContent = '✅ Open voting for this week';
            }
        }

        async function closeThemeVote() {
            const btn = document.getElementById('btn-theme-close');
            btn.disabled = true;
            btn.textContent = 'Closing…';

            try {
                const res = await fetch('{{ path('app_admin_theme_vote_close') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ force: true }),
                });
                const data = await res.json();

                if (res.ok) {
                    const msg = data.winner
                        ? 'Theme Thursday winner: ' + data.winner + ' (' + data.counts[0].votes + ' votes)'
                        : 'No votes cast this week';
                    showToast(msg);
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.error || 'Failed to close voting', true);
                }
            } catch {
                showToast('Could not reach server', true);
            } finally {
                btn.disabled = false;
                btn.textContent = '🔒 Close voting & announce winner';
            }
        }

        /* ── Side navigation scrollspy ── */
        const sideNavLinks = document.querySelectorAll('#sideNav a[data-section]');
        const sections = Array.from(sideNavLinks).map(link => {
            const id = link.dataset.section;
            return document.getElementById(id);
        }).filter(Boolean);

        function updateActiveLink() {
            const scrollPos = window.scrollY + window.innerHeight / 3;
            let activeSection = null;
            let highestTop = -Infinity;

            sections.forEach(section => {
                const top = section.offsetTop;
                const bottom = top + section.offsetHeight;
                if (scrollPos >= top && scrollPos < bottom && top > highestTop) {
                    highestTop = top;
                    activeSection = section;
                }
            });

            // If at bottom of page, activate last section
            if (!activeSection && window.innerHeight + window.scrollY >= document.body.offsetHeight - 50) {
                activeSection = sections[sections.length - 1];
            }

            sideNavLinks.forEach(link => {
                link.classList.toggle('active', link.dataset.section === (activeSection?.id || ''));
            });
        }

        window.addEventListener('scroll', updateActiveLink, { passive: true });
        window.addEventListener('resize', updateActiveLink);
        updateActiveLink();

        // Smooth scroll on click
        function setActiveLink(activeLink) {
            sideNavLinks.forEach(l => l.classList.toggle('active', l === activeLink));
        }

        sideNavLinks.forEach((link, index) => {
            link.addEventListener('click', e => {
                e.preventDefault();
                // First link (Radio controls) scrolls to very top
                if (index === 0) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    setActiveLink(link);
                } else {
                    const target = document.querySelector(link.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        setActiveLink(link);
                    }
                }
            });
        });
    </script>
