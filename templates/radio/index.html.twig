<script>
let scheduledStartAt  = null; // 'HH:MM' from API, or null
let currentDjClipUrl  = null;
let audioUnlocked     = false;
let birthdayActive    = false;
let alarmActive       = false;
let confettiInterval  = null;

// TEST MODE: Set to true to simulate voting open with mock data
const THEME_VOTE_TEST_MODE = {{ theme_vote_test_mode ? 'true' : 'false' }};

function updateDateTime() {
    const now = new Date();
    const days = ['Zondag', 'Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag'];
    const months = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];

    const dayName = days[now.getDay()];
    const day = now.getDate();
    const month = months[now.getMonth()];
    const year = now.getFullYear();

    const dateEl = document.getElementById('date-text');
    const timeEl = document.getElementById('time-text');

    if (dateEl) dateEl.textContent = `Het is ${dayName} ${day} ${month} ${year}`;
    if (timeEl) timeEl.textContent = now.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

async function fetchWeather() {
    try {
        const res = await fetch('/api/weather', { cache: 'no-cache' });
        if (!res.ok) throw new Error('Weather unavailable');
        const data = await res.json();
        const iconEl = document.getElementById('weather-icon');
        const descEl = document.getElementById('weather-desc');
        const tempEl = document.getElementById('weather-temp');
        if (!iconEl || !descEl || !tempEl) return;

        const desc = data.description || 'Onbekend';
        const temp = data.temp !== undefined ? data.temp : '--';

        // Map weather condition to icon
        const condition = (data.description || '').toLowerCase();
        let icon = '🌤️';
        if (condition.includes('zonnig') || condition.includes('clear')) icon = '☀️';
        else if (condition.includes('bewolkt') || condition.includes('cloud')) icon = '☁️';
        else if (condition.includes('regen') || condition.includes('rain') || condition.includes('drizzle')) icon = '🌧️';
        else if (condition.includes('onweer') || condition.includes('thunder')) icon = '⛈️';
        else if (condition.includes('sneeuw') || condition.includes('snow')) icon = '❄️';
        else if (condition.includes('mist') || condition.includes('fog') || condition.includes('haze')) icon = '🌫️';

        iconEl.textContent = icon;
        descEl.textContent = desc.charAt(0).toUpperCase() + desc.slice(1);
        tempEl.querySelector('.temp-value').textContent = temp;
    } catch (e) {
        // Silently fail
    }
}

async function fetchBirthdays() {
    try {
        const res = await fetch('/api/birthdays', { cache: 'no-cache' });
        if (!res.ok) throw new Error('Birthdays unavailable');
        const data = await res.json();
        const listEl = document.getElementById('birthdays-list');
        if (!listEl) return;

        if (!data || data.length === 0) {
            listEl.innerHTML = '<div class="birthdays-empty">Geen verjaardagen gevonden</div>';
            return;
        }

        listEl.innerHTML = data.map(b => `
            <div class="birthday-item${b.days_until === 0 ? ' is-today' : ''}">
                ${b.picture
                    ? `<img class="avatar" src="${b.picture}" alt="${b.name}">`
                    : `<div class="avatar-placeholder">🎂</div>`
                }
                <div class="info">
                    <div class="name">${b.name}</div>
                    <div class="days">${b.days_until === 0 ? 'Vandaag!' : `over ${b.days_until} dag${b.days_until === 1 ? '' : 'en'}`}</div>
                </div>
                ${b.days_until === 0 ? '<div class="party-emojis">🎉 🎈 🥳</div>' : ''}
            </div>
        `).join('');
    } catch (e) {
        // Silently fail
    }
}

async function fetchThemeVote() {
    try {
        // TEST MODE: Use mock data to preview pie chart
        if (THEME_VOTE_TEST_MODE) {
            const mockData = {
                is_open: true,
                is_thursday: false,
                winner: null,
                counts: [
                    { theme: 'Nederpop Classics', count: 12 },
                    { theme: '90s Alternatief', count: 8 },
                    { theme: 'Soul & Funk', count: 5 }
                ]
            };
            return renderThemeVoteStatus(mockData);
        }

        const res = await fetch('/api/theme-vote/public-status', { cache: 'no-cache' });
        if (!res.ok) throw new Error('Theme vote unavailable');
        const data = await res.json();
        return renderThemeVoteStatus(data);
    } catch (e) {
        // Silently fail
    }
}

function renderThemeVoteStatus(data) {
    const statusEl = document.getElementById('theme-vote-status');
    if (!statusEl) return;

    const colors = ['#2ea3f2', '#86efac', '#f59e0b', '#f87171', '#a855f7', '#06b6d4'];

    if (data.is_open) {
        if (data.counts && data.counts.length > 0) {
            const total = data.counts.reduce((sum, c) => sum + c.count, 0);
            const countsHtml = data.counts.map((c, i) => {
                const percentage = total > 0 ? Math.round((c.count / total) * 100) : 0;
                const color = colors[i % colors.length];
                return `<div class="vote-count" style="display:flex;align-items:center;gap:0.5rem;margin:0.35rem 0;">
                    <span style="width:12px;height:12px;background:${color};border-radius:3px;flex-shrink:0;"></span>
                    <span style="color:rgba(255,255,255,0.85);">${c.theme}</span>
                    <span style="color:${color};font-weight:700;">${percentage}%</span>
                </div>`;
            }).join('');
            statusEl.innerHTML = `<div class="vote-counts">${countsHtml}</div>`;
        }
    } else if (data.is_thursday) {
        statusEl.innerHTML = data.winner
            ? `<span class="winner">🏆 Winnaar: ${data.winner}</span>`
            : '<span class="closed">Geen stemmen</span>';
    } else {
        statusEl.innerHTML = data.winner
            ? `<span class="winner">🏆 Winnaar: ${data.winner}</span>`
            : '<span class="closed">Stemmen gesloten. Je kunt van maandag tot woensdag stemmen.</span>';
    }
}

function renderPieChart(counts) {
    const total = counts.reduce((sum, c) => sum + c.count, 0);
    if (total === 0) return '';
    
    const colors = ['#2ea3f2', '#86efac', '#f59e0b', '#f87171', '#a855f7', '#06b6d4'];
    
    let svg = '<div class="pie-chart" style="margin-top:1rem;display:flex;justify-content:center;">';
    svg += '<svg width="120" height="120" viewBox="0 0 120 120">';
    
    let startAngle = -Math.PI / 2; // Start at top
    const radius = 50;
    const centerX = 60;
    const centerY = 60;
    
    counts.forEach((item, index) => {
        const percentage = item.count / counts.reduce((sum, c) => sum + c.count, 0);
        const angle = percentage * 2 * Math.PI;
        const endAngle = startAngle + angle;
        
        const x1 = centerX + radius * Math.cos(startAngle);
        const y1 = centerY + radius * Math.sin(startAngle);
        const x2 = centerX + radius * Math.cos(endAngle);
        const y2 = centerY + radius * Math.sin(endAngle);
        
        const largeArc = angle > Math.PI ? 1 : 0;
        const color = colors[index % colors.length];
        
        svg += `<path d="M ${centerX} ${centerY} L ${x1} ${y1} A ${radius} ${radius} 0 ${largeArc} 1 ${x2} ${y2} Z" fill="${color}" opacity="0.9" />`;
        
        // Add label for percentage > 10%
        if (item.count / counts.reduce((sum, c) => sum + c.count, 0) > 0.1) {
            const labelAngle = startAngle + angle / 2;
            const labelRadius = radius * 0.7;
            const labelX = centerX + labelRadius * Math.cos(labelAngle);
            const labelY = centerY + labelRadius * Math.sin(labelAngle);
            const percentage = Math.round((item.count / counts.reduce((sum, c) => sum + c.count, 0)) * 100);
            svg += `<text x="${labelX}" y="${labelY}" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="10" font-weight="bold">${percentage}%</text>`;
        }
        
        startAngle = endAngle;
    });
    
    svg += '</svg>';
    svg += '<div class="pie-legend" style="margin-top:0.5rem;display:flex;flex-wrap:wrap;justify-content:center;gap:0.5rem;font-size:0.75rem;">';
    
    counts.forEach((item, index) => {
        const percentage = Math.round((item.count / counts.reduce((sum, c) => sum + c.count, 0)) * 100);
        const color = colors[index % colors.length];
        svg += `<span style="display:flex;align-items:center;gap:0.25rem;color:rgba(255,255,255,0.8);"><span style="width:10px;height:10px;background:${color};border-radius:2px;"></span>${item.theme} (${percentage}%)</span>`;
    });
    
    svg += '</div></div>';
    
    return svg;
}

setInterval(updateDateTime, 1000);
setInterval(fetchWeather, 300000); // Every 5 minutes
setInterval(fetchBirthdays, 3600000); // Every hour
setInterval(fetchThemeVote, 5000); // Every 5 seconds
updateDateTime();
fetchWeather();
fetchBirthdays();
fetchThemeVote();

function showAlarm(key, summary) {
    if (alarmActive) return;
    alarmActive = true;
    document.getElementById('alarm-key').textContent     = key;
    document.getElementById('alarm-summary').textContent = summary;
    document.getElementById('alarm-overlay').classList.add('active');
}

function hideAlarm() {
    if (!alarmActive) return;
    alarmActive = false;
    document.getElementById('alarm-overlay').classList.remove('active');
}

function showBirthday(name, picture) {
    if (birthdayActive) return;
    birthdayActive = true;

    document.getElementById('bday-name').textContent = name;

    const wrap = document.getElementById('bday-photo-wrap');
    wrap.innerHTML = '';
    if (picture) {
        const img = document.createElement('img');
        img.src       = picture;
        img.className = 'bday-photo';
        img.alt       = name;
        wrap.appendChild(img);
    } else {
        const av = document.createElement('div');
        av.className   = 'bday-avatar';
        av.textContent = '🎂';
        wrap.appendChild(av);
    }

    document.getElementById('birthday-overlay').classList.add('active');
    startConfetti();
}

function hideBirthday() {
    if (!birthdayActive) return;
    birthdayActive = false;
    document.getElementById('birthday-overlay').classList.remove('active');
    stopConfetti();
}

const CONFETTI_COLORS = ['#f39c12','#e74c3c','#2ea3f2','#2ecc71','#9b59b6','#f1c40f','#e91e63','#00bcd4'];

function spawnConfetti() {
    const overlay = document.getElementById('birthday-overlay');
    for (let i = 0; i < 6; i++) {
        const el = document.createElement('div');
        el.className = 'confetti';
        el.style.left            = Math.random() * 100 + 'vw';
        el.style.top             = '-20px';
        el.style.background      = CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];
        el.style.width           = (6 + Math.random() * 10) + 'px';
        el.style.height          = (6 + Math.random() * 10) + 'px';
        el.style.borderRadius    = Math.random() > 0.5 ? '50%' : '2px';
        const dur                = 2.5 + Math.random() * 3;
        el.style.animationDuration = dur + 's';
        el.style.animationDelay    = (Math.random() * 0.8) + 's';
        overlay.appendChild(el);
        setTimeout(() => el.remove(), (dur + 1) * 1000);
    }
}

function startConfetti() {
    spawnConfetti();
    confettiInterval = setInterval(spawnConfetti, 600);
}

function stopConfetti() {
    clearInterval(confettiInterval);
    confettiInterval = null;
}

function tuneIn() {
    audioUnlocked = true;
    document.getElementById('tune-in-overlay').style.display = 'none';
}

// Auto-dismiss the tune-in overlay after 3s for devices without a mouse
setTimeout(() => {
    if (!audioUnlocked) tuneIn();
}, 3000);

function fadeUpdate(el, newText) {
    if (el.textContent === newText) return;
    el.style.opacity = '0';
    setTimeout(() => {
        el.textContent = newText;
        el.style.opacity = '1';
    }, 400);
}

function rampVolume(audio, from, to, durationMs) {
    const steps    = 30;
    const interval = durationMs / steps;
    const diff     = (to - from) / steps;
    let step = 0;
    const timer = setInterval(() => {
        step++;
        audio.volume = Math.max(0, Math.min(1, from + diff * step));
        if (step >= steps) clearInterval(timer);
    }, interval);
}

let djAudio = null;

function playDjClip(url) {
    if (!audioUnlocked) return;
    if (djAudio) { djAudio.pause(); djAudio = null; }

    // Stop tick-based progress so it doesn't fight with timeupdate
    clearInterval(progressTimer);
    progressTimer = null;

    const path  = new URL(url, window.location.href).pathname;
    const audio = new Audio(path);
    djAudio = audio;
    audio.volume = 0;

    audio.addEventListener('loadedmetadata', () => {
        // Use the real audio duration and reset to 0 so the bar starts clean
        durationMs = Math.round(audio.duration * 1000);
        progressMs = 0;
        updateProgressUI();
        const fadeOutAt = Math.max(0, audio.duration - 1.5);
        setTimeout(() => rampVolume(audio, 1, 0, 1500), fadeOutAt * 1000);
    });

    audio.addEventListener('timeupdate', () => {
        if (djAudio !== audio) return;
        progressMs = Math.round(audio.currentTime * 1000);
        updateProgressUI();
    });

    audio.addEventListener('ended', () => {
        if (djAudio === audio) {
            djAudio = null;
            schedulePoll(500); // hand control back to normal track progress
        }
    });

    audio.play().catch(() => { djAudio = null; });
    rampVolume(audio, 0, 1, 1000);
}

let progressMs  = 0;
let durationMs  = 0;
let progressTimer = null;
let isPlaying   = false;
let lastTrack   = '';

function fmtMs(ms) {
    const totalSec = Math.max(0, Math.floor(ms / 1000));
    const m = Math.floor(totalSec / 60);
    const s = String(totalSec % 60).padStart(2, '0');
    return `${m}:${s}`;
}

function updateProgressUI() {
    if (durationMs <= 0) {
        document.getElementById('progress-bar').style.width = '0%';
        document.getElementById('time-elapsed').textContent   = '0:00';
        document.getElementById('time-remaining').textContent = '-0:00';
        return;
    }
    document.getElementById('progress-bar').style.width =
        (progressMs / durationMs * 100) + '%';
    document.getElementById('time-elapsed').textContent   = fmtMs(progressMs);
    document.getElementById('time-remaining').textContent = '-' + fmtMs(durationMs - progressMs);
}

function tickProgress() {
    if (djAudio) return; // audio element drives progress while DJ clip is playing
    if (durationMs <= 0) return;
    progressMs = Math.min(progressMs + 1000, durationMs);
    updateProgressUI();
    // Track reached end locally — poll immediately for the next track
    if (progressMs >= durationMs) {
        schedulePoll(500);
    }
}

function setOnAir(playing) {
    isPlaying = playing;
    const dot   = document.getElementById('dot');
    const label = document.getElementById('on-air-label');
    const fpRanking = document.getElementById('fullpage-ranking');
    if (playing) {
        dot.classList.remove('inactive');
        label.textContent = 'on air';
        fpRanking.classList.remove('active');
    } else {
        dot.classList.add('inactive');
        label.textContent = 'wachten…';
        fpRanking.classList.remove('active');
    }
}

async function poll() {
    try {
        const res  = await fetch('/api/now-playing', { cache: 'no-cache' });
        const data = await res.json();

        if (data.status === 'waiting' && data.start_at) {
            scheduledStartAt = data.start_at;
            document.getElementById('block-playing').style.display   = 'none';
            document.getElementById('on-air-label').textContent = 'start om ' + data.start_at;
            setOnAir(false);
            return;
        }

        scheduledStartAt = null;
        document.getElementById('block-playing').style.display   = 'flex';

        // Sonos plays audio directly on the speaker — no browser audio unlock needed
        if (!audioUnlocked && (data.playback_method === 'upnp' || data.playback_method === 'sonos_api')) {
            audioUnlocked = true;
            document.getElementById('tune-in-overlay').style.display = 'none';
        }

        const track  = data.track  || '—';
        const artist = data.artist || '—';

        fadeUpdate(document.getElementById('track'),   track);
        fadeUpdate(document.getElementById('artist'),  artist);
        fadeUpdate(document.getElementById('dj-text'), data.dj_text || '');

        const albumImg = document.getElementById('album-art');
        if (data.image && albumImg.dataset.src !== data.image) {
            albumImg.dataset.src = data.image;
            albumImg.style.opacity = '0';
            setTimeout(() => {
                albumImg.src = data.image;
                albumImg.style.display = 'block';
                albumImg.style.opacity = '1';
            }, 400);
        } else if (!data.image) {
            albumImg.style.opacity = '0';
            setTimeout(() => { albumImg.style.display = 'none'; }, 400);
        }

        if (data.dj_clip_url && data.dj_clip_url !== currentDjClipUrl) {
            currentDjClipUrl = data.dj_clip_url;
            playDjClip(data.dj_clip_url);
        } else if (!data.dj_clip_url) {
            currentDjClipUrl = null;
        }

        if (track !== lastTrack) {
            lastTrack = track;
            baseHue   = trackToHue(track + artist);
        }

        if (data.birthday_active && data.birthday_name) {
            showBirthday(data.birthday_name, data.birthday_picture || null);
        } else {
            hideBirthday();
        }

        if (data.alarm_active && data.alarm_key) {
            showAlarm(data.alarm_key, data.alarm_summary || '');
        } else {
            hideAlarm();
        }

        setOnAir(data.is_playing);

        // While a DJ clip is playing in the browser, the <audio> element drives
        // progressMs/durationMs via timeupdate — don't let the server clock override it.
        if (!djAudio) {
            durationMs = data.duration_ms || 0;
            progressMs = data.progress_ms || 0;
            updateProgressUI();

            clearInterval(progressTimer);
            if (data.is_playing) progressTimer = setInterval(tickProgress, 1000);
        }

    } catch (e) {
        setOnAir(false);
    }
}

let pollTimer = null;

function schedulePoll(delayMs) {
    clearTimeout(pollTimer);
    pollTimer = setTimeout(async () => {
        await poll();
        // If track is ending soon, poll fast; otherwise every 5s
        const remaining = durationMs - progressMs;
        schedulePoll(remaining > 0 && remaining < 15000 ? 2000 : 5000);
    }, delayMs);
}

schedulePoll(0);

// ── Jira highest-priority tickets ─────────────────────────────────────────
let knownJiraKeys = null;
let lastJiraData = '';

async function pollJira() {
    try {
        const res     = await fetch('/api/jira-tickets');
        const tickets = await res.json();
        const panel   = document.getElementById('jira-section');
        const list    = document.getElementById('jira-list');
        const headerLabel = panel.querySelector('.jira-header-label');

        // Create a comparable string of current ticket data
        const currentData = JSON.stringify(tickets.map(t => ({ key: t.key })));

        // Only proceed if data actually changed
        if (currentData === lastJiraData) return;
        lastJiraData = currentData;

        if (tickets.length === 0) {
            panel.classList.remove('hidden');
            panel.classList.add('all-good');
            if (headerLabel) headerLabel.textContent = 'Geen highest ticket';
            list.innerHTML = '<span class="jira-all-good">Niets aan de hand, relax</span>';
            knownJiraKeys = [];
            return;
        }

        panel.classList.remove('all-good');
        if (headerLabel) headerLabel.textContent = 'Highest Ticket';

        panel.classList.remove('hidden');

        // Detect new tickets (after first load) and flash the panel
        const currentKeys = tickets.map(t => t.key);
        if (knownJiraKeys !== null) {
            const hasNew = currentKeys.some(k => !knownJiraKeys.includes(k));
            if (hasNew) {
                list.style.animation = 'none';
                list.offsetHeight; // reflow
            }
        }
        knownJiraKeys = currentKeys;

        list.innerHTML = tickets.map(t => `
            <div class="jira-ticket">
                <div class="jira-key-only">${t.key}</div>
            </div>
        `).join('');
    } catch (e) {}
}

setInterval(pollJira, 5000);
pollJira();

// ── News ticker ─────────────────────────────────────────────────────────
async function pollNews() {
    try {
        const res  = await fetch('/api/news-headlines', { cache: 'no-cache' });
        const data = await res.json();
        const wrap = document.getElementById('ticker-wrap');
        const container = document.getElementById('ticker-items');

        if (!data || data.length === 0) {
            wrap.style.display = 'none';
            return;
        }

        wrap.style.display = 'flex';

        // Duplicate items for seamless infinite scroll
        const items = [...data, ...data].map(h => `<span class="ticker-item">${h}</span>`).join('');
        container.innerHTML = items;
    } catch {}
}

setInterval(pollNews, 120000);
pollNews();
// ──────────────────────────────────────────────────────────────────────────
</script>
