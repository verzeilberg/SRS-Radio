{% extends 'base.html.twig' %}

{% block title %}{{ station }}{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
        height: 100%;
        overflow: hidden;
        font-family: 'Lato', sans-serif;
        color: #fff;
        background: #0a1929;
    }

    /* ── News ticker ── */
    .ticker-wrap {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2.2rem;
        background: rgba(10,25,41,.92);
        border-bottom: 1px solid rgba(46,163,242,.2);
        overflow: hidden;
        z-index: 100;
        display: flex;
        align-items: center;
    }

    .ticker-track {
        flex: 1;
        overflow: hidden;
        position: relative;
        height: 100%;
    }

    .ticker-items {
        display: flex;
        gap: 0;
        position: absolute;
        white-space: nowrap;
        will-change: transform;
        animation: ticker-scroll 60s linear infinite;
        height: 100%;
        align-items: center;
    }

    .ticker-item {
        display: inline-flex;
        align-items: center;
        gap: .75rem;
        padding: 0 2.5rem;
        font-size: .78rem;
        color: #88bbdd;
        letter-spacing: .02em;
    }

    .ticker-item::before {
        content: '•';
        color: #2ea3f2;
        font-size: .6rem;
    }

    .ticker-item:first-child::before {
        display: none;
    }

    @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    /* ── Grid Layout ── */
    .grid-container {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: repeat(3, 1fr);
        height: calc(100vh - 2.2rem);
        padding-top: 2.2rem;
        gap: 1rem;
        padding: 3rem 2rem 2rem;
    }

    .grid-cell {
        background: rgba(20,75,124,0.6);
        border: 1px solid rgba(46,163,242,0.15);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        overflow: hidden;
        min-height: 0;
    }

    .grid-cell .logo {
        height: clamp(60px, 12vh, 120px);
        filter: brightness(0) invert(1);
    }

    .grid-cell .logo-info {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        width: 100%;
    }

    .grid-cell .logo-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .grid-cell .logo-left .logo {
        height: clamp(40px, 8vh, 70px);
        margin-bottom: 0.25rem;
    }

    .grid-cell .welcome-text {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1rem, 2.5vh, 1.5rem);
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.6);
    }

    .grid-cell .date-text {
        font-size: clamp(0.85rem, 2vh, 1.1rem);
        font-weight: 400;
        color: rgba(255,255,255,0.5);
    }

    .grid-cell .time-text {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.5rem, 4vh, 2.5rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        color: #2ea3f2;
        letter-spacing: 0.05em;
    }

    .grid-cell .logo-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.35rem;
    }

    .grid-cell .weather-icon {
        font-size: clamp(3.5rem, 7vh, 5rem);
        line-height: 1;
    }

    .grid-cell .weather-desc {
        font-size: clamp(1.1rem, 2.5vh, 1.5rem);
        font-weight: 500;
        color: rgba(255,255,255,0.85);
        text-align: right;
        line-height: 1.3;
    }

    .grid-cell .weather-temp {
        display: flex;
        align-items: flex-start;
        gap: 0.15rem;
    }

    .grid-cell .weather-temp .temp-value {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(3.5rem, 8vh, 5.5rem);
        font-weight: 900;
        font-variant-numeric: tabular-nums;
        color: #ffffff;
        line-height: 1;
    }

    .grid-cell .weather-temp .temp-unit {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.3rem, 3vh, 2rem);
        font-weight: 700;
        color: rgba(255,255,255,0.7);
        margin-top: 0.2em;
    }

    .grid-cell .track-info {
        text-align: center;
        width: 100%;
    }

    .grid-cell .track {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.5rem, 4vh, 2.8rem);
        font-weight: 900;
        color: #ffffff;
        line-height: 1.15;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .grid-cell .artist {
        font-size: clamp(1rem, 2.5vh, 1.3rem);
        font-weight: 300;
        color: #2ea3f2;
        letter-spacing: 0.04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .grid-cell .progress-wrap {
        width: 100%;
        margin-top: 1rem;
    }

    .grid-cell .progress-track {
        height: 6px;
        background: rgba(255,255,255,0.12);
        border-radius: 3px;
        overflow: hidden;
        width: 100%;
        margin-bottom: 0.5rem;
    }

    .grid-cell .progress-bar {
        height: 100%;
        background: #2ea3f2;
        border-radius: 2px;
        width: 0%;
        transition: width 1s linear;
    }

    .grid-cell .progress-times {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.45);
        font-variant-numeric: tabular-nums;
    }

    .grid-cell .countdown-block {
        text-align: center;
    }

    .grid-cell .countdown {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(2.5rem, 6vh, 4rem);
        font-weight: 900;
        color: #2ea3f2;
        letter-spacing: 0.05em;
    }

    .grid-cell .countdown-label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
    }

    .grid-cell .dj-text {
        font-size: 1rem;
        line-height: 1.7;
        color: rgba(255,255,255,0.4);
        font-style: italic;
        font-weight: 300;
        text-align: center;
        max-width: 100%;
    }

    .grid-cell .jira-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
    }

    .grid-cell .jira-header-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ff4d4d;
        flex-shrink: 0;
        animation: pulse-red 1.6s ease-in-out infinite;
    }

    .grid-cell .jira-header-label {
        font-family: 'Raleway', sans-serif;
        font-size: 1.2rem;
        font-weight: 900;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.85);
    }

    .grid-cell .jira-empty {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.2);
        font-style: italic;
    }

    .grid-cell .jira-all-good {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-size: 1.3rem;
        font-weight: 600;
        color: #ffffff;
        text-align: center;
        padding: 1.5rem;
        white-space: nowrap;
    }

    .grid-cell.cell-jira,
.grid-cell#jira-section {
        background: linear-gradient(135deg, #a83232 0%, #7a1f1f 50%, #5c0d0d 100%);
        border: none;
        box-shadow:
            inset 0 2px 4px rgba(255,255,255,0.15),
            inset 0 -2px 8px rgba(0,0,0,0.3),
            inset 0 0 20px rgba(0,0,0,0.2),
            0 0 0 1px rgba(255,255,255,0.05);
    }

    .grid-cell.cell-jira.all-good,
    .grid-cell#jira-section.all-good {
        background: linear-gradient(135deg, #1a8c4a 0%, #146b3a 50%, #0d4d28 100%);
        border: none;
        box-shadow:
            inset 0 2px 4px rgba(255,255,255,0.15),
            inset 0 -2px 8px rgba(0,0,0,0.3),
            inset 0 0 20px rgba(0,0,0,0.2),
            0 0 0 1px rgba(255,255,255,0.05);
    }

    .grid-cell.cell-jira.all-good .jira-header,
    .grid-cell#jira-section.all-good .jira-header {
        display: block;
        text-align: center;
        padding: 1rem 0;
    }

    .grid-cell.cell-jira.all-good .jira-header-label,
    .grid-cell#jira-section.all-good .jira-header-label {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .grid-cell.cell-jira.all-good #jira-list,
    .grid-cell#jira-section.all-good #jira-list {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 1rem;
    }

    .grid-cell .jira-ticket {
        background: transparent;
        border: none;
        border-left: none;
        border-radius: 0;
        padding: 0.5rem;
        margin-bottom: 0.5rem;
        animation: slide-in 0.35s ease;
    }

    .grid-cell .jira-key {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: #ff6b6b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
    }

    .grid-cell .jira-summary {
        font-size: 0.85rem;
        font-weight: 400;
        color: rgba(255,255,255,0.85);
        line-height: 1.4;
        margin-bottom: 0.4rem;
    }

    .grid-cell .jira-status {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
    }

    .grid-cell .jira-key-only {
        display: block;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #ff6b6b;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .grid-cell .ranking-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1rem;
        width: 100%;
    }

    .grid-cell .ranking-header-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2ea3f2;
        flex-shrink: 0;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .grid-cell .ranking-header-label {
        font-family: 'Raleway', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #2ea3f2;
    }

    .grid-cell .on-air {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.7rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
        font-weight: 300;
    }

    .grid-cell .on-air-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #2ea3f2;
        flex-shrink: 0;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .grid-cell .on-air-dot.inactive {
        background: rgba(255,255,255,0.2);
        animation: none;
    }

    .grid-cell .setup-link {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.2);
        text-decoration: none;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        transition: color 0.2s;
    }
    .grid-cell .setup-link:hover { color: rgba(255,255,255,0.6); }

    .hidden { display: none !important; }

    .extra-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1rem, 2.5vh, 1.5rem);
        font-weight: 700;
        color: rgba(255,255,255,0.3);
        text-align: center;
        padding: 1rem;
    }

    .birthdays-content {
        align-items: flex-start;
        justify-content: flex-start;
        padding: 0 1rem 0.25rem;
        gap: 0.35rem;
    }

    .birthdays-title {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.1rem, 2.5vh, 1.5rem);
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2ea3f2;
        margin-bottom: 0.5rem;
    }

    .theme-vote-content {
        align-items: flex-start;
        justify-content: flex-start;
        padding: 0 1rem 0.25rem;
        gap: 0.35rem;
        width: 100%;
    }

    .theme-vote-title {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.1rem, 2.5vh, 1.5rem);
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2ea3f2;
        margin-bottom: 0.5rem;
    }

    .theme-vote-status {
        width: 100%;
        font-size: clamp(0.9rem, 2vh, 1.1rem);
        color: rgba(255,255,255,0.8);
        line-height: 1.5;
    }

    .theme-vote-status .winner {
        font-weight: 700;
        color: #2ea3f2;
    }

    .theme-vote-status .open {
        color: #86efac;
    }

    .theme-vote-status .closed {
        color: #f87171;
    }

    .birthdays-title {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.1rem, 2.5vh, 1.5rem);
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2ea3f2;
        margin-bottom: 0.5rem;
    }

    .birthdays-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .birthday-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem;
        background: rgba(255,255,255,0.05);
        border-radius: 8px;
        transition: all 0.3s ease;
        position: relative;
    }

    .birthday-item.is-today {
        background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(255,165,0,0.15));
        border: 1px solid rgba(255,215,0,0.4);
        box-shadow: 0 0 12px rgba(255,215,0,0.15);
    }

    .birthday-item.is-today .name {
        color: #ffd700;
        font-weight: 900;
    }

    .birthday-item.is-today .days {
        color: #ffd700;
        font-weight: 700;
    }

    .birthday-item.is-today .avatar-placeholder {
        background: linear-gradient(135deg, rgba(255,215,0,0.3), rgba(255,165,0,0.2));
        animation: birthday-pulse 1.5s ease-in-out infinite;
    }

    @keyframes birthday-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255,215,0,0.4); }
        50% { box-shadow: 0 0 0 8px rgba(255,215,0,0); }
    }

    .birthday-item .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .birthday-item .avatar-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .birthday-item .info {
        flex: 1;
        min-width: 0;
    }

    .birthday-item .name {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(0.9rem, 2vh, 1.1rem);
        font-weight: 700;
        color: #ffffff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .birthday-item .days {
        font-size: clamp(0.75rem, 1.8vh, 0.9rem);
        color: rgba(255,255,255,0.5);
    }

    .birthday-item .party-emojis {
        display: flex;
        gap: 0.35rem;
        font-size: 1.2rem;
        animation: party-bounce 1s ease-in-out infinite;
        margin-left: auto;
    }

    @keyframes party-bounce {
        0%, 100% { transform: translateY(0) rotate(-3deg); }
        50% { transform: translateY(-4px) rotate(3deg); }
    }

    .birthdays-empty {
        color: rgba(255,255,255,0.3);
        font-style: italic;
        text-align: center;
        padding: 1rem;
    }

    .split {
        display: flex;
        height: 100vh;
        padding-top: 2.2rem;
    }

    .panel-left {
        flex: 1;
        background: #144b7c;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 4rem;
        gap: clamp(0.6rem, 1.8vh, 2.25rem);
        overflow: hidden;
    }

    .panel-right {
        width: 50%;
        background: #0a1929;
        display: flex;
        flex-direction: column;
        padding: 2.5rem 2rem;
        overflow-y: auto;
    }

    .panel-right:has(.jira-section.hidden):has(.ranking-section.hidden) {
        display: none;
    }

    .jira-section.hidden {
        display: none;
    }

    .ranking-section {
        border-top: 1px solid rgba(255,255,255,0.06);
        padding-top: 1.5rem;
        margin-top: 1.5rem;
    }

    .ranking-section.hidden {
        display: none;
    }

    .top {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
    }

    .logo {
        height: clamp(60px, 10vh, 110px);
        filter: brightness(0) invert(1);
    }

    .station {
        font-family: 'Raleway', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
    }

    .eq-row {
        display: flex;
        align-items: flex-end;
        width: 90%;
        gap: 1.5rem;
    }

    .eq-unit {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
    }

    .eq-unit svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .eq-label {
        font-family: 'Raleway', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
    }

    .middle {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .track-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        text-align: left;
    }

    .track {
        font-family: 'Raleway', sans-serif;
        font-size: clamp(1.3rem, 3vh, 2.4rem);
        font-weight: 900;
        color: #ffffff;
        line-height: 1.15;
        transition: opacity 0.4s ease;
    }

    .artist {
        font-size: 1.1rem;
        font-weight: 300;
        color: #2ea3f2;
        letter-spacing: 0.04em;
        transition: opacity 0.4s ease;
    }

    .progress-wrap {
        width: 100%;
    }

    .progress-track {
        height: 5px;
        background: rgba(255,255,255,0.12);
        border-radius: 3px;
        overflow: hidden;
        width: 100%;
        margin-bottom: 0.5rem;
    }

    .progress-bar {
        height: 100%;
        background: #2ea3f2;
        border-radius: 2px;
        width: 0%;
        transition: width 1s linear;
    }

    .progress-times {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.45);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.03em;
    }

    .on-air {
        position: fixed;
        bottom: 1.25rem;
        left: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.7rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
        font-weight: 300;
        z-index: 10;
    }

    .on-air-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #2ea3f2;
        flex-shrink: 0;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .on-air-dot.inactive {
        background: rgba(255,255,255,0.2);
        animation: none;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.15; }
    }

    .dj-text {
        font-size: 1.05rem;
        line-height: 1.85;
        color: rgba(255,255,255,0.4);
        font-style: italic;
        font-weight: 300;
        max-width: 440px;
        transition: opacity 0.4s ease;
    }

    .countdown-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
    }

    .countdown {
        font-family: 'Raleway', sans-serif;
        font-size: 3.5rem;
        font-weight: 900;
        color: #2ea3f2;
        letter-spacing: 0.05em;
    }

    .countdown-label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: 700;
    }

    .setup-link {
        position: fixed;
        bottom: 1.25rem;
        right: 1.5rem;
