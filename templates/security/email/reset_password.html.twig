<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SRS Radio - Password Reset</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Lato', sans-serif; background-color: #0a1929; color: #fff;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; padding: 2rem;">
        <tr>
            <td style="background: #112240; border: 1px solid #1e3a5f; border-radius: 12px; padding: 2.5rem;">
                <div style="text-align: center; margin-bottom: 1.5rem;">
                    <div style="font-size: 2.5rem; margin-bottom: .5rem;">📻</div>
                    <h1 style="font-family: 'Raleway', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: .1em; color: #64b5f6; margin: 0;">SRS RADIO</h1>
                </div>

                <p style="font-size: 1rem; color: #a0b8d8; line-height: 1.6; margin-bottom: 1.5rem;">You requested to reset your password. Click the button below to create a new one:</p>

                <div style="text-align: center; margin: 2rem 0;">
                    <a href="{{ resetUrl }}" style="display: inline-block; background: #1565c0; color: #fff; font-family: 'Raleway', sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: .08em; padding: .75rem 1.5rem; border-radius: 6px; text-decoration: none;">Reset Password</a>
                </div>

                <p style="font-size: .85rem; color: #6b8aad; margin-bottom: 0;">If the button doesn't work, copy and paste this link into your browser:</p>
                <p style="font-size: .8rem; color: #64b5f6; word-break: break-all; font-family: monospace; background: #0d1f35; border: 1px solid #1e3a5f; border-radius: 6px; padding: .75rem; margin-top: .5rem;">{{ resetUrl }}</p>

                <hr style="border: none; border-top: 1px solid #1e3a5f; margin: 1.5rem 0;">

                <p style="font-size: .8rem; color: #6b8aad; margin: 0;">This link will expire in 1 hour for security reasons.</p>
                <p style="font-size: .8rem; color: #6b8aad; margin: .5rem 0 0;">If you didn't request this, you can safely ignore this email.</p>
            </td>
        </tr>
        <tr>
            <td style="text-align: center; padding-top: 1rem;">
                <p style="font-size: .75rem; color: #4a6a8a; margin: 0;">SRS Radio</p>
            </td>
        </tr>
    </table>
</body>
</html>