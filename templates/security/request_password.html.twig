<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SRS Radio – Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            height: 100%;
            font-family: 'Lato', sans-serif;
            background: #0a1929;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: #112240;
            border: 1px solid #1e3a5f;
            border-radius: 12px;
            padding: 2.5rem 2.75rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 60px rgba(0,0,0,.5);
        }

        .logo-wrap {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .logo-icon {
            font-size: 2.5rem;
            display: block;
            margin-bottom: .5rem;
        }

        h1 {
            font-family: 'Raleway', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: .1em;
            text-align: center;
            color: #64b5f6;
        }

        .subtitle {
            text-align: center;
            font-size: .85rem;
            color: #6b8aad;
            margin-top: .25rem;
        }

        .error-box {
            background: rgba(239,68,68,.15);
            border: 1px solid rgba(239,68,68,.4);
            border-radius: 6px;
            padding: .75rem 1rem;
            margin: 1.25rem 0 0;
            font-size: .875rem;
            color: #fca5a5;
        }

        .success-box {
            background: rgba(34,197,94,.15);
            border: 1px solid rgba(34,197,94,.4);
            border-radius: 6px;
            padding: .75rem 1rem;
            margin: 1.25rem 0 0;
            font-size: .875rem;
            color: #86efac;
        }

        .form-group {
            margin-top: 1.25rem;
        }

        label {
            display: block;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #6b8aad;
            margin-bottom: .4rem;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            width: 100%;
            background: #0d1f35;
            border: 1px solid #1e3a5f;
            border-radius: 6px;
            padding: .65rem .9rem;
            color: #fff;
            font-size: .95rem;
            font-family: 'Lato', sans-serif;
            transition: border-color .2s;
            outline: none;
        }

        input:focus {
            border-color: #2196f3;
        }

        .btn {
            width: 100%;
            margin-top: 1.5rem;
            padding: .75rem;
            background: #1565c0;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-family: 'Raleway', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: .08em;
            cursor: pointer;
            transition: background .2s;
        }

        .btn:hover { background: #1976d2; }

        .login-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: .8rem;
            color: #4a6a8a;
        }

        .login-link a {
            color: #4a6a8a;
            text-decoration: none;
            border-bottom: 1px solid #2a4a6a;
            transition: color .2s;
        }

        .login-link a:hover { color: #64b5f6; }

        .flash-messages {
            list-style: none;
            margin-bottom: 1rem;
        }

        .flash-messages li {
            padding: .75rem 1rem;
            border-radius: 6px;
            font-size: .875rem;
            margin-bottom: .5rem;
        }

        .flash-messages .flash-error {
            background: rgba(239,68,68,.15);
            border: 1px solid rgba(239,68,68,.4);
            color: #fca5a5;
        }

        .flash-messages .flash-success {
            background: rgba(34,197,94,.15);
            border: 1px solid rgba(34,197,94,.4);
            color: #86efac;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo-wrap">
            <span class="logo-icon">📻</span>
            <h1>SRS RADIO</h1>
            <p class="subtitle">Forgot your password?</p>
        </div>

        <ul class="flash-messages">
            {% for message in app.flashes('error') %}
                <li class="flash-error">{{ message }}</li>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <li class="flash-success">{{ message }}</li>
            {% endfor %}
        </ul>

        <form method="post">
            <div class="form-group">
                <label for="email">Email address</label>
                <input type="email" id="email" name="email" autocomplete="email" required autofocus>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

            <button type="submit" class="btn">Send reset link</button>
        </form>

        <p class="login-link">
            <a href="{{ path('app_login') }}">Back to sign in</a>
        </p>
    </div>
</body>
</html>